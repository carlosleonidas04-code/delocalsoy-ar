{
  "openapi": "3.1.0",
  "info": {
    "title": "DELocalSoy.AR Federated API Contract",
    "version": "7.8.0",
    "description": "Reconciliado CORE-004 (regla documental, #87): documenta todas las rutas montadas en apps/api/src/app.ts. R1: 11 rutas v7.7.0. R3 (ADR-031): /api/auth/* + system.* reservado (H-01). EV-031/EV-032."
  },
  "paths": {
    "/api/health": {
      "get": {
        "summary": "Honest Runtime Health (R5, mode resuelto desde events_raw — R7)",
        "responses": {
          "200": {
            "description": "OK (mode: real) o estado declarado (synthetic | degraded)"
          }
        }
      }
    },
    "/api/health/mode": {
      "patch": {
        "summary": "Authenticated Mode Switch, sellado en events_raw (R5/R8)",
        "responses": {
          "200": {
            "description": "Transición sellada"
          },
          "401": {
            "description": "Unauthorized"
          },
          "503": {
            "description": "No se pudo sellar la transición (sin base)"
          }
        }
      }
    },
    "/api/auth/register": {
      "post": {
        "summary": "CORE-004 R3 (ADR-031): alta de ciudadano — email único, password >= 8 (scrypt); sella system.user_registered sin PII",
        "responses": {
          "201": {
            "description": "Usuario creado (rol: ciudadano)"
          },
          "400": {
            "description": "Datos inválidos (contrato Zod)"
          },
          "409": {
            "description": "Email ya registrado"
          }
        }
      }
    },
    "/api/auth/login": {
      "post": {
        "summary": "CORE-004 R3: login → access token JWT HS256 (15 min); sella system.user_session sin PII",
        "responses": {
          "200": {
            "description": "Token + usuario"
          },
          "400": {
            "description": "Datos inválidos"
          },
          "401": {
            "description": "Credenciales inválidas (genérico)"
          },
          "503": {
            "description": "Sin JWT_SECRET o sin base para sellar"
          }
        }
      }
    },
    "/api/auth/me": {
      "get": {
        "summary": "CORE-004 R3: identidad de la sesión (guard requireJwt, fail-closed sin JWT_SECRET)",
        "responses": {
          "200": {
            "description": "Usuario de la sesión"
          },
          "401": {
            "description": "Bearer token ausente o inválido"
          },
          "503": {
            "description": "Sin JWT_SECRET"
          }
        }
      }
    },
    "/api/territorios": {
      "get": {
        "summary": "PostGIS BBOX Spatial Filter (SRID=4326)",
        "parameters": [
          {
            "name": "bbox",
            "in": "query",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          },
          "400": {
            "description": "Invalid BBOX"
          }
        }
      }
    },
    "/api/evidencias": {
      "get": {
        "summary": "Registro de evidencias ejecutables (EV-xxx)",
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/events": {
      "post": {
        "summary": "Idempotent SHA-256 Event Log (EV-005); anti-PII server-side (ADR-027, Ley 25.326); system.* reservado del sistema (H-01, R3a)",
        "responses": {
          "200": {
            "description": "Duplicate (re-ingesta idempotente: mismo hash, original intacto)"
          },
          "201": {
            "description": "Created"
          },
          "400": {
            "description": "Bad Request (type y occurred_at inválidos, o PII detectada — sin eco del valor)"
          },
          "403": {
            "description": "Tipo reservado del sistema: system.* no se acepta por la ingesta pública"
          }
        }
      }
    },
    "/api/nodos": {
      "get": {
        "summary": "Vocabulario CORE-003 (EV-029): listar nodos federados con población INDEC y centro",
        "responses": {
          "200": {
            "description": "OK — envelope {success, data, count}"
          },
          "500": {
            "description": "Error interno"
          }
        }
      }
    },
    "/api/nodos/{key}": {
      "get": {
        "summary": "Un nodo federado por key (capital | caucete | iglesia)",
        "parameters": [
          {
            "name": "key",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK — envelope {success, data}"
          },
          "404": {
            "description": "Nodo no encontrado (honesto, R15)"
          },
          "500": {
            "description": "Error interno"
          }
        }
      }
    },
    "/api/nodos/{key}/capas": {
      "get": {
        "summary": "Catálogo de capas del nodo",
        "parameters": [
          {
            "name": "key",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK — envelope {success, data, count}"
          },
          "404": {
            "description": "Nodo no encontrado"
          }
        }
      }
    },
    "/api/nodos/{key}/categorias": {
      "get": {
        "summary": "Categorías de reporte del nodo (layer = capa.key)",
        "parameters": [
          {
            "name": "key",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK — envelope {success, data, count}"
          },
          "404": {
            "description": "Nodo no encontrado"
          }
        }
      }
    },
    "/api/nodos/{key}/features": {
      "get": {
        "summary": "Features del nodo (domain heredado de la capa, lat/lng, is_synthetic)",
        "parameters": [
          {
            "name": "key",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK — envelope {success, data, count}"
          },
          "404": {
            "description": "Nodo no encontrado"
          }
        }
      }
    },
    "/api/nodos/{key}/reportes": {
      "get": {
        "summary": "Reportes del nodo (flujo received → resolved)",
        "parameters": [
          {
            "name": "key",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK — envelope {success, data, count}"
          },
          "404": {
            "description": "Nodo no encontrado"
          }
        }
      }
    }
  }
}
