}

/* Traceability & Evidencias Panel */
.idempotency-log {
  margin-top: 1rem;
  padding: 0.65rem 0.85rem;
  border-radius: var(--radius-sm, 6px);
  border: 1px solid var(--status-aprobado-border, #10b981);
  background: var(--status-aprobado-bg, #d1fae5);
  color: var(--status-aprobado-text, #065f46);
}

.trace-evidencias-grid {
  margin-top: 1.25rem;
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 1.5rem;
  align-items: start;
}

@media (max-width: 900px) {
  .trace-evidencias-grid {
    grid-template-columns: 1fr;
  }
}

.events-stream {
  margin-top: 0.75rem;
  display: flex;
  flex-direction: column;
  gap: 0.65rem;
  max-height: 440px;
  overflow-y: auto;
}

.event-row {
  padding: 0.75rem 0;
  border-bottom: 1px solid rgba(148, 163, 184, 0.2);
}

.event-row-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 0.5rem;
  font-size: 0.85rem;
}

.event-row-meta {
  margin-top: 0.25rem;
  display: flex;
  gap: 0.45rem;
  font-size: 0.76rem;
  opacity: 0.75;
}

.event-payload {
  margin-top: 0.4rem;
  padding: 0.45rem 0.6rem;
  font-size: 0.76rem;
}

/* Shared Lists, Filter Controls & Forms */
.filter-group {
  display: flex;
  gap: 0.35rem;
  flex-wrap: wrap;
}

.btn-filter {
  padding: 0.4rem 0.75rem;
  border-radius: var(--radius-sm, 6px);
  border: 1px solid var(--color-border-default);
  background: var(--color-bg-elevated);
  color: var(--color-text-secondary);
  font-size: 0.8rem;
  font-weight: 500;
  cursor: pointer;
  white-space: nowrap;
  transition: border-color var(--duration-fast) var(--ease-out-expo),
    background-color var(--duration-fast) var(--ease-out-expo),
    color var(--duration-fast) var(--ease-out-expo);
}

.btn-filter.active {
  background: var(--color-accent-primary, #c2410c);
  border-color: var(--color-accent-primary, #c2410c);
  color: #ffffff;
  font-weight: 600;
}

.territory-list {
  list-style: none;
  padding: 0;
  margin: 0.85rem 0 0;
  display: flex;
  flex-direction: column;
}

.territory-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 1rem;
  padding: 0.85rem 0;
  border-bottom: 1px solid rgba(148, 163, 184, 0.18);
}

.territory-info {
  display: flex;
  flex-direction: column;
  gap: 0.22rem;
}

.territory-name {
  font-weight: 600;
  font-size: 0.95rem;
}

.territory-meta {
  font-size: 0.81rem;
  opacity: 0.78;
}

.territory-actions {
  display: flex;
  align-items: center;
  gap: 0.45rem;
  flex-shrink: 0;
}

.btn-toggle {
  padding: 0.4rem 0.75rem;
  border-radius: var(--radius-sm, 6px);
  border: 1px solid var(--color-border-default);
  background: var(--color-bg-elevated);
  color: var(--color-text-primary);
  font-size: 0.78rem;
  font-weight: 500;
  cursor: pointer;
  white-space: nowrap;
  transition: border-color var(--duration-fast) var(--ease-out-expo),
    background-color var(--duration-fast) var(--ease-out-expo);
}

.btn-toggle:hover,
.btn-filter:hover {
  border-color: var(--color-border-strong);
}

.territory-form {
  margin-top: 1rem;
  padding-top: 1rem;
  border-top: 1px solid var(--color-border-hairline);
  display: flex;
  gap: 0.5rem;
  flex-wrap: wrap;
}

.territory-form input {
  flex: 1 1 180px;
  padding: 0.5rem 0.75rem;
  border-radius: var(--radius-sm, 6px);
  border: 1px solid var(--color-border-default);
  background: var(--color-bg-inset, #f4f0e6);
  color: var(--color-text-primary);
  font-size: 0.86rem;
}

.territory-form button {
  padding: 0.5rem 1rem;
  border-radius: var(--radius-sm, 6px);
  border: 1px solid var(--color-accent-primary, #c2410c);
  background: var(--color-accent-primary, #c2410c);
  color: #ffffff;
  font-weight: 600;
  font-size: 0.86rem;
  cursor: pointer;
  white-space: nowrap;
  transition: background-color var(--duration-fast) var(--ease-out-expo);
}

.territory-form button:hover:not(:disabled) {
  background: var(--color-accent-primary-hover, #9a3412);
}

.territory-form button:disabled {
  opacity: 0.6;
  cursor: not-allowed;
}

.form-field {
  margin-top: 0.85rem;
  display: flex;
  flex-direction: column;
  gap: 0.35rem;
  font-size: 0.84rem;
}

.form-field select,
.form-field textarea {
  padding: 0.5rem 0.65rem;
  border-radius: var(--radius-sm, 6px);
  border: 1px solid var(--color-border-default);
  background: var(--color-bg-inset, #f4f0e6);
  color: var(--color-text-primary);
  font-family: inherit;
  font-size: 0.86rem;
}

.picker-svg {
  width: 100%;
  height: 110px;
  border-radius: var(--radius-sm, 6px);
  border: 1px solid var(--color-border-default);
  cursor: crosshair;
}

.empty-state {
  margin: 1rem 0 0;
  color: var(--color-text-muted);
  font-size: 0.9rem;
}

pre {
  margin: 0.65rem 0 0;
  padding: 0.75rem;
  border-radius: var(--radius-md, 10px);
  background: var(--color-bg-inset, #f4f0e6);
  border: 1px solid var(--color-border-hairline);
  color: var(--color-text-primary);
  overflow-x: auto;
  font-size: 0.82rem;
  font-family: var(--font-mono, 'JetBrains Mono', monospace);
}

.ok {
  color: var(--status-aprobado-text, #065f46);
  font-weight: 600;
}

.error {
  color: var(--status-rechazado-text, #991b1b);
  font-weight: 600;
}

.hint {
  color: var(--color-text-secondary);
  font-size: 0.88rem;
}

footer {
  margin-top: 2.5rem;
  padding-top: 1.25rem;
  border-top: 1px solid var(--color-border-default);
  color: var(--color-text-muted);
  font-size: 0.84rem;
}

code {
  font-family: var(--font-mono, 'JetBrains Mono', monospace);
  background: var(--color-bg-subtle, #e9e2d4);
  color: var(--color-text-primary);
  padding: 0.1rem 0.35rem;
  border-radius: var(--radius-xs, 4px);
  font-size: 0.82em;
}

.quota-banner {
  background: #fffbeb;
  border-bottom: 1px solid #fde68a;
  color: #78350f;
  padding: 0.65rem 1rem;
  font-size: 0.85rem;
  text-align: center;
  position: sticky;
  top: 0;
  z-index: 50;
  width: 100%;
}

.quota-banner a {
  text-decoration: underline;
  font-weight: 600;
  color: #451a03;
}

.map-wrapper {
  position: relative;
  width: 100%;
  height: 440px;
  margin-top: 1rem;
  border-radius: 10px;
  overflow: hidden;
  border: 1px solid rgba(148, 163, 184, 0.25);
}

.map-status-pill {
  position: absolute;
  top: 12px;
  left: 12px;
  z-index: 10;
  background: rgba(15, 23, 42, 0.88);
  color: #ffffff;
  padding: 0.35rem 0.75rem;
  border-radius: 6px;
  font-size: 0.78rem;
}

/* Custom Map Layer Control UI (MapControl inside TerritoriosMap) */
.layer-color-dot {
  display: inline-block;
  width: 8px;
  height: 8px;
  border-radius: 50%;
  margin-right: 0.4rem;
  vertical-align: middle;
}

.map-layer-control-card {
  margin: 12px;
  padding: 0.7rem 0.85rem;
  min-width: 245px;
  border-radius: 8px;
  background: rgba(15, 23, 42, 0.92);
  color: #f8fafc;
  border: 1px solid rgba(148, 163, 184, 0.35);
  backdrop-filter: blur(8px);
  font-family: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, sans-serif;
  display: flex;
  flex-direction: column;
  gap: 0.55rem;
}

.map-layer-control-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 0.5rem;
  padding-bottom: 0.4rem;
  border-bottom: 1px solid rgba(148, 163, 184, 0.22);
}

.map-layer-control-title {
  font-size: 0.76rem;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.04em;
  color: #e2e8f0;
}

.map-layer-control-count {
  font-size: 0.72rem;
  color: #94a3b8;
}

.map-layer-toggle-list {
  display: flex;
  flex-direction: column;
  gap: 0.35rem;
}

.map-layer-toggle-item {
  display: flex;
  align-items: center;
  gap: 0.4rem;
  padding: 0.32rem 0.45rem;
  border-radius: 6px;
  border: 1px solid rgba(148, 163, 184, 0.2);
  background: rgba(30, 41, 59, 0.55);
  cursor: pointer;
  font-size: 0.79rem;
  user-select: none;
}

.map-layer-toggle-item.active {
  border-color: rgba(46, 158, 91, 0.65);
  background: rgba(46, 158, 91, 0.14);
}

.map-layer-toggle-item input[type='checkbox'] {
  margin: 0;
  accent-color: #2e9e5b;
  cursor: pointer;
}

.map-layer-toggle-label {
  flex: 1;
  font-weight: 500;
  color: #f1f5f9;
}

.map-layer-toggle-badge {
  font-size: 0.72rem;
  font-weight: 700;
  color: #cbd5e1;
}

.map-layer-control-actions {
  display: flex;
  justify-content: space-between;
  gap: 0.4rem;
  padding-top: 0.35rem;
  border-top: 1px solid rgba(148, 163, 184, 0.2);
}

.map-layer-mini-btn {
  flex: 1;
  padding: 0.25rem 0.45rem;
  border-radius: 5px;
  border: 1px solid rgba(148, 163, 184, 0.32);
  background: transparent;
  color: #e2e8f0;
  font-size: 0.72rem;
  cursor: pointer;
}

.map-layer-mini-btn:hover {
  border-color: rgba(148, 163, 184, 0.75);
  background: rgba(148, 163, 184, 0.12);
}

.auth-box {
  margin-top: 1rem;
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: 0.75rem;
}

.user-bar {
  display: flex;
  align-items: center;
  gap: 0.6rem;
}

.user-email {
  font-size: 0.82rem;
  opacity: 0.8;
}

.workspace-grid {
  margin-top: 1rem;
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(340px, 1fr));
  gap: 1.5rem;
}

.workspace-Pane h3 {
  margin: 0 0 0.6rem;
  font-size: 0.95rem;
}

.pane-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 0.75rem;
  flex-wrap: wrap;
}

.search-row {
  display: flex;
  gap: 0.4rem;
}

.search-row input {
  padding: 0.35rem 0.65rem;
  border-radius: 6px;
  border: 1px solid rgba(148, 163, 184, 0.35);
  background: rgba(15, 23, 42, 0.15);
  color: inherit;
  font-size: 0.82rem;
}

.link-btn {
  text-decoration: none;
}

.btn-danger {
  color: #dc2626;
  border-color: rgba(220, 38, 38, 0.4);
}

.doc-viewer {
  margin-top: 1rem;
  padding-top: 1rem;
  border-top: 1px solid rgba(148, 163, 184, 0.25);
}

.doc-content {
  max-height: 240px;
  overflow-y: auto;
  white-space: pre-wrap;
}

.modal-backdrop {
  position: fixed;
  inset: 0;
  background: rgba(15, 23, 42, 0.72);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 100;
  padding: 1rem;
}

.modal-card {
  max-width: 480px;
  width: 100%;
  padding: 1.5rem;
  border-radius: 12px;
  background: #1e293b;
  color: #f8fafc;
  border: 1px solid rgba(148, 163, 184, 0.35);
}

.modal-card h3 {
  margin-top: 0;
}

.modal-actions {
  margin-top: 1.25rem;
  display: flex;
  justify-content: flex-end;
  gap: 0.6rem;
}

.btn-confirm {
  padding: 0.48rem 0.95rem;
  border-radius: var(--radius-sm, 6px);
  border: 1px solid var(--color-accent-primary, #c2410c);
  background: var(--color-accent-primary, #c2410c);
  color: #ffffff;
  font-weight: 600;
  font-size: 0.84rem;
  cursor: pointer;
  white-space: nowrap;
  transition: background-color var(--duration-fast) var(--ease-out-expo),
    border-color var(--duration-fast) var(--ease-out-expo);
}

.btn-confirm:hover:not(:disabled) {
  background: var(--color-accent-primary-hover, #9a3412);
  border-color: var(--color-accent-primary-hover, #9a3412);
}

.btn-danger-solid {
  border-color: #dc2626;
  background: #dc2626;
}

/* Official Sign in with Google button styles */
.gsi-material-button {
  -moz-user-select: none;
  -webkit-user-select: none;
  -ms-user-select: none;
  -webkit-appearance: none;
  background-color: #ffffff;
  background-image: none;
  border: 1px solid #747775;
  border-radius: 4px;
  box-sizing: border-box;
  color: #1f1f1f;
  cursor: pointer;
  font-family: 'Roboto', arial, sans-serif;
  font-size: 14px;
  height: 40px;
  letter-spacing: 0.25px;
  outline: none;
  overflow: hidden;
  padding: 0 12px;
  position: relative;
  text-align: center;
  transition: background-color 0.218s, border-color 0.218s, box-shadow 0.218s;
  vertical-align: middle;
  white-space: nowrap;
  width: auto;
  max-width: 400px;
  min-width: min-content;
}

.gsi-material-button .gsi-material-button-icon {
  height: 20px;
  margin-right: 12px;
  min-width: 20px;
  width: 20px;
}

.gsi-material-button .gsi-material-button-content-wrapper {
  align-items: center;
  display: flex;
  flex-direction: row;
  flex-wrap: nowrap;
  height: 100%;
  justify-content: space-between;
  position: relative;
  width: 100%;
}

.gsi-material-button .gsi-material-button-contents {
  flex-grow: 1;
  font-family: 'Roboto', arial, sans-serif;
  font-weight: 500;
  overflow: hidden;
  text-overflow: ellipsis;
  vertical-align: top;
}

.gsi-material-button .gsi-material-button-state {
  transition: opacity 0.218s;
  bottom: 0;
  left: 0;
  opacity: 0;
  position: absolute;
  right: 0;
  top: 0;
}

/* Recharts Quarterly Trends Section */
.charts-two-col-grid {
  margin-top: 1.25rem;
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 1.5rem;
}

@media (max-width: 960px) {
  .charts-two-col-grid {
    grid-template-columns: 1fr;
  }
}

.chart-panel {
  padding: 1rem 1.15rem;
  border-radius: var(--radius-md, 10px);
  border: 1px solid var(--color-border-default);
  background: var(--color-bg-elevated);
  display: flex;
  flex-direction: column;
  gap: 0.75rem;
}

.chart-container-box {
  width: 100%;
  min-height: 300px;
}

.quarters-summary-strip {
  margin-top: 1.25rem;
  padding-top: 1.1rem;
  border-top: 1px solid rgba(148, 163, 184, 0.2);
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 1rem;
}

@media (max-width: 960px) {
  .quarters-summary-strip {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
}

@media (max-width: 560px) {
  .quarters-summary-strip {
    grid-template-columns: 1fr;
  }
}

.quarter-summary-cell {
  display: flex;
  flex-direction: column;
  gap: 0.28rem;
  padding-right: 0.5rem;
  border-right: 1px solid rgba(148, 163, 184, 0.16);
}

.quarter-summary-cell:last-child {
  border-right: none;
}

.quarter-cell-title {
  font-size: 0.88rem;
}

/* Workspace Export Configurator (Google Docs & Google Drive) */
.export-config-box {
  margin-top: 1rem;
  padding: 1rem 1.15rem;
  border-radius: var(--radius-md, 10px);
  border: 1px solid var(--color-border-default);
  background: var(--color-bg-elevated);
  display: flex;
  flex-direction: column;
  gap: 0.85rem;
}

.export-controls-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 1rem;
  align-items: end;
}

@media (max-width: 960px) {
  .export-controls-grid {
    grid-template-columns: 1fr;
  }
}

.export-title-input {
  padding: 0.5rem 0.65rem;
  border-radius: var(--radius-sm, 6px);
  border: 1px solid var(--color-border-default);
  background: var(--color-bg-inset);
  color: var(--color-text-primary);
  font-family: inherit;
  font-size: 0.86rem;
  width: 100%;
}

.workspace-feedback-bar {
  margin-top: 1rem;
  padding: 0.75rem 1rem;
  border-radius: var(--radius-md, 10px);
  border: 1px solid var(--status-aprobado-border);
  background: var(--status-aprobado-bg);
  color: var(--status-aprobado-text);
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 0.75rem;
  flex-wrap: wrap;
}

/* Federated Node Detail Modal ('Explorar nodo') */
.node-detail-modal-card {
  max-width: 880px;
  width: 100%;
  max-height: 88vh;
  display: flex;
  flex-direction: column;
  padding: 1.5rem;
  overflow: hidden;
  background: var(--color-bg-surface);
  color: var(--color-text-primary);
}

.node-modal-header {
  padding-bottom: 1rem;
