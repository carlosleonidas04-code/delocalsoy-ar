:root {
  font-family: var(--font-sans, 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif);
}

* {
  box-sizing: border-box;
}

html {
  scroll-behavior: smooth;
}

body {
  margin: 0;
  min-height: 100vh;
  background: var(--color-bg-canvas, #f7f5f0);
  color: var(--color-text-primary, #141923);
  font-size: var(--text-base, 0.96875rem);
  line-height: var(--leading-normal, 1.6);
  transition: background-color var(--duration-normal, 200ms) var(--ease-out-expo),
    color var(--duration-normal, 200ms) var(--ease-out-expo);
}

@media (prefers-color-scheme: dark) {
  :root:not([data-theme='light']) body {
    background: var(--color-bg-canvas, #0b111e);
    color: var(--color-text-primary, #f1f5f9);
    letter-spacing: var(--tracking-wide, 0.015em);
  }
}

:root[data-theme='dark'] body {
  background: var(--color-bg-canvas, #0b111e);
  color: var(--color-text-primary, #f1f5f9);
  letter-spacing: var(--tracking-wide, 0.015em);
}

:focus-visible {
  outline: 2px solid var(--color-accent-primary, #c2410c);
  outline-offset: 2px;
}

.tabular-nums {
  font-variant-numeric: tabular-nums;
}

.whitespace-nowrap {
  white-space: nowrap;
  flex-shrink: 0;
}

/* 3-Zone Top Bar Contract (Universal Design Constitution §2) */
.top-bar {
  position: sticky;
  top: 0;
  z-index: 40;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--space-8, 2rem);
  padding: 0.85rem var(--space-8, 2rem);
  background: var(--color-bg-topbar, rgba(17, 24, 39, 0.96));
  backdrop-filter: blur(12px);
  border-bottom: 1px solid var(--color-border-default, rgba(148, 163, 184, 0.2));
  color: var(--color-text-on-dark, #f8fafc);
}

.brand-wordmark {
  font-family: var(--font-display, 'Fraunces', Georgia, serif);
  font-size: 1.22rem;
  font-weight: 700;
  letter-spacing: -0.02em;
  color: var(--color-text-on-dark, #f8fafc);
  text-decoration: none;
  white-space: nowrap;
  flex-shrink: 0;
}

.top-nav {
  display: flex;
  align-items: center;
  gap: 1.5rem;
  flex-wrap: nowrap;
  overflow-x: auto;
}

.top-nav a {
  color: #cbd5e1;
  text-decoration: none;
  font-size: var(--text-sm, 0.875rem);
  font-weight: 500;
  white-space: nowrap;
  flex-shrink: 0;
  transition: color var(--duration-fast, 140ms) var(--ease-out-expo);
}

.top-nav a:hover {
  color: #ffffff;
  text-decoration: underline;
  text-underline-offset: 4px;
}

.top-actions {
  display: flex;
  align-items: center;
  gap: 0.75rem;
  flex-shrink: 0;
}

.container {
  max-width: 1200px;
  width: 100%;
  margin: 0 auto;
  padding: var(--space-8, 2rem);
}

/* Hero Banner */
.hero-banner {
  padding: 2rem 0 1.5rem;
  border-bottom: 1px solid var(--color-border-default, rgba(20, 25, 35, 0.15));
}

.kicker-text {
  display: block;
  font-size: var(--text-xs, 0.75rem);
  font-weight: 600;
  letter-spacing: 0.01em;
  color: var(--color-accent-primary, #c2410c);
  margin-bottom: 0.45rem;
}

h1 {
  margin: 0;
  font-family: var(--font-display, 'Fraunces', Georgia, serif);
  font-size: var(--text-hero, clamp(2.15rem, 3.6vw, 3.15rem));
  font-weight: 600;
  letter-spacing: var(--tracking-tight, -0.022em);
  line-height: var(--leading-tight, 1.2);
  max-width: 36ch;
  text-wrap: balance;
  color: var(--color-text-primary);
}

.subtitle {
  margin: 0.75rem 0 0;
  color: var(--color-text-secondary);
  max-width: 72ch;
  font-size: var(--text-base, 0.96875rem);
  line-height: var(--leading-relaxed, 1.72);
}

.hero-metrics-strip {
  margin-top: 1.5rem;
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(175px, 1fr));
  gap: 1.25rem;
  padding-top: 1.25rem;
  border-top: 1px solid var(--color-border-hairline, rgba(20, 25, 35, 0.09));
}

.hero-metrics-strip > div {
  display: flex;
  flex-direction: column;
  gap: 0.2rem;
}

.hero-metrics-strip strong {
  font-family: var(--font-mono, monospace);
  font-size: 1.35rem;
  font-weight: 700;
  color: var(--color-accent-primary, #c2410c);
}

.hero-metrics-strip span {
  font-size: var(--text-xs, 0.75rem);
  color: var(--color-text-muted);
}

/* Cards & Sections (Single-Elevation Depth · 60-30-10 Surface System) */
.card {
  margin-top: var(--space-8, 2rem);
  padding: var(--space-6, 1.5rem) 1.75rem;
  border-radius: var(--radius-lg, 14px);
  background: var(--color-bg-surface, #ffffff);
  border: 1px solid var(--color-border-default, rgba(20, 25, 35, 0.15));
  box-shadow: var(--shadow-card);
}

.card h2 {
  margin: 0;
  font-family: var(--font-display, 'Fraunces', Georgia, serif);
  font-size: var(--text-xl, 1.375rem);
  font-weight: 600;
  letter-spacing: -0.015em;
  line-height: var(--leading-snug, 1.36);
  text-wrap: balance;
  color: var(--color-text-primary);
}

.card[data-state='ok'] {
  border-color: var(--color-border-default);
}

.card[data-state='error'] {
  border-color: var(--status-rechazado-border, #ef4444);
}

.section-header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 1rem;
  flex-wrap: wrap;
}

.section-caption {
  margin: 0.4rem 0 0;
  font-size: var(--text-sm, 0.875rem);
  color: var(--color-text-secondary);
  max-width: 72ch;
}

.tiny-label {
  display: block;
  font-size: var(--text-xs, 0.75rem);
  font-weight: 600;
  color: var(--color-text-muted);
  margin-bottom: 0.35rem;
}

/* Horizon 1 Architecture Panel */
.pillar-tabs-grid {
  margin-top: 1.25rem;
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(230px, 1fr));
  gap: 0.75rem;
}

.pillar-tab {
  text-align: left;
  padding: 0.9rem 1rem;
  border-radius: var(--radius-md, 10px);
  border: 1px solid var(--color-border-default);
  background: var(--color-bg-elevated);
  color: inherit;
  cursor: pointer;
  transition: border-color var(--duration-fast) var(--ease-out-expo),
    background-color var(--duration-fast) var(--ease-out-expo);
}

.pillar-tab.active {
  border-color: var(--color-accent-primary, #c2410c);
  background: var(--color-accent-subtle, #fff7ed);
}

.pillar-tab-top {
  display: flex;
  align-items: baseline;
  gap: 0.4rem;
  margin-bottom: 0.25rem;
  font-size: 0.92rem;
}

.pillar-index {
  color: var(--color-accent-primary, #c2410c);
  font-family: var(--font-mono, monospace);
  font-weight: 700;
}

.pillar-detail-box {
  margin-top: 1.25rem;
  padding-top: 1.25rem;
  border-top: 1px solid rgba(148, 163, 184, 0.2);
}

.pillar-chain-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
  gap: 1.25rem;
}

.pillar-chain-col p {
  margin: 0.25rem 0 0;
  font-size: 0.88rem;
  opacity: 0.9;
}

.pillar-invariants-row {
  margin-top: 1rem;
  padding-top: 0.85rem;
  border-top: 1px solid rgba(148, 163, 184, 0.15);
}

.horizon-projection-bar {
  margin-top: 1.35rem;
  padding-top: 1.25rem;
  border-top: 1px solid rgba(148, 163, 184, 0.22);
}

.horizon-detail-row {
  margin-top: 0.85rem;
  display: grid;
  grid-template-columns: 1.1fr 1fr;
  gap: 1.25rem;
  align-items: start;
}

@media (max-width: 820px) {
  .horizon-detail-row {
    grid-template-columns: 1fr;
  }
}

.horizon-deliverables-list {
  margin: 0;
  padding-left: 1.15rem;
  font-size: 0.85rem;
  display: flex;
  flex-direction: column;
  gap: 0.35rem;
  opacity: 0.9;
}

/* Federated Node Explorer */
.node-selector-grid {
  margin-top: 1.25rem;
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
  gap: 0.85rem;
}

.node-card {
  text-align: left;
  padding: 1rem;
  border-radius: var(--radius-md, 10px);
  border: 1px solid var(--color-border-default, rgba(20, 25, 35, 0.15));
  background: var(--color-bg-elevated, transparent);
  color: inherit;
  cursor: pointer;
  display: flex;
  flex-direction: column;
  gap: 0.35rem;
  transition: border-color var(--duration-fast, 140ms) var(--ease-out-expo),
    background-color var(--duration-fast, 140ms) var(--ease-out-expo);
}

.node-card.active {
  border-color: var(--color-accent-primary, #c2410c);
  background: var(--color-accent-subtle, rgba(194, 65, 12, 0.08));
}

.node-card-header {
  display: flex;
  align-items: center;
  gap: 0.4rem;
  flex-wrap: wrap;
}

.node-dot {
  width: 9px;
  height: 9px;
  border-radius: 50%;
  display: inline-block;
  flex-shrink: 0;
}

.node-subtitle {
  font-size: 0.8rem;
  opacity: 0.75;
  font-weight: 400;
}

.node-focus {
  font-size: 0.84rem;
  font-weight: 600;
  color: var(--color-accent-secondary, #1f6e50);
}

.node-desc {
  margin: 0;
  font-size: 0.8rem;
  opacity: 0.8;
  line-height: 1.45;
}

.node-footer-meta {
  margin-top: auto;
  padding-top: 0.5rem;
  display: flex;
  align-items: center;
  gap: 0.35rem;
  flex-wrap: wrap;
  font-size: 0.75rem;
  opacity: 0.72;
}

.federated-workspace {
  margin-top: 1.5rem;
  padding-top: 1.5rem;
  border-top: 1px solid rgba(148, 163, 184, 0.22);
  display: grid;
  grid-template-columns: 380px 1fr;
  gap: 1.5rem;
  align-items: start;
}

@media (max-width: 960px) {
  .federated-workspace {
    grid-template-columns: 1fr;
  }
}

.federated-sidebar {
  display: flex;
  flex-direction: column;
  gap: 1.35rem;
}

.node-summary-top {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 0.75rem;
}

.node-summary-top h3 {
  margin: 0;
  font-size: 1.05rem;
}

.stats-mini-grid {
  margin-top: 0.85rem;
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 0.5rem;
  padding: 0.75rem 0;
  border-top: 1px solid rgba(148, 163, 184, 0.18);
  border-bottom: 1px solid rgba(148, 163, 184, 0.18);
}

.stat-box {
  display: flex;
  flex-direction: column;
}

.stat-box strong {
  font-size: 1.15rem;
}

.stat-box span {
  font-size: 0.74rem;
  opacity: 0.72;
}

.layers-list {
  display: flex;
  flex-direction: column;
  gap: 0.45rem;
}

.layer-btn {
  text-align: left;
  padding: 0.6rem 0.75rem;
  border-radius: 6px;
  border: 1px solid rgba(148, 163, 184, 0.24);
  background: transparent;
  color: inherit;
  cursor: pointer;
}

.layer-btn.active {
  background: rgba(46, 158, 91, 0.08);
}

.layer-btn-main {
  display: flex;
  align-items: center;
  gap: 0.5rem;
  font-weight: 600;
  font-size: 0.85rem;
}

.layer-check {
  width: 10px;
  height: 10px;
  border-radius: 3px;
  flex-shrink: 0;
}

.layer-meta-row {
  margin-top: 0.25rem;
  display: flex;
  gap: 0.4rem;
  flex-wrap: wrap;
  font-size: 0.74rem;
  opacity: 0.72;
}

.btn-create-report {
  padding: 0.38rem 0.75rem;
  border-radius: 6px;
  border: none;
  color: #ffffff;
  font-size: 0.78rem;
  font-weight: 600;
  cursor: pointer;
  white-space: nowrap;
}

.reports-list {
  margin-top: 0.65rem;
  display: flex;
  flex-direction: column;
  gap: 0.65rem;
}

.report-card {
  padding: 0.75rem 0;
  border-top: 1px solid rgba(148, 163, 184, 0.2);
}

.report-card-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 0.5rem;
  font-size: 0.86rem;
}

.status-inline {
  font-size: 0.76rem;
  font-weight: 600;
}

.report-desc {
  margin: 0.35rem 0;
  font-size: 0.84rem;
  opacity: 0.88;
}

.report-history {
  font-size: 0.75rem;
  opacity: 0.72;
}

.report-card-actions {
  margin-top: 0.45rem;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 0.5rem;
}

/* Schematic Symbolic Map & Features */
.federated-main {
  display: flex;
  flex-direction: column;
  gap: 1.35rem;
}

.schematic-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 0.75rem;
  flex-wrap: wrap;
  font-size: 0.84rem;
  margin-bottom: 0.6rem;
}

.schematic-legend {
  display: flex;
  align-items: center;
  gap: 0.85rem;
  font-size: 0.76rem;
  opacity: 0.85;
}

.schematic-legend i {
  display: inline-block;
  width: 8px;
  height: 8px;
  border-radius: 50%;
  margin-right: 4px;
}

.dot-problem {
  background: #e0703a;
}

.dot-asset {
  background: #2e9e5b;
}

.dot-report {
  background: #f5c842;
}

.schematic-svg {
  width: 100%;
  height: auto;
  max-height: 290px;
  background: #0b1120;
  border-radius: 8px;
  border: 1px solid rgba(148, 163, 184, 0.25);
  display: block;
}

.features-strip {
  margin-top: 0.75rem;
  display: flex;
  flex-wrap: wrap;
  gap: 0.45rem;
}

.feature-chip {
  display: inline-flex;
  align-items: center;
  gap: 0.4rem;
  padding: 0.35rem 0.65rem;
  border-radius: 6px;
  border: 1px solid rgba(148, 163, 184, 0.26);
  background: transparent;
  color: inherit;
  font-size: 0.78rem;
  cursor: pointer;
  text-align: left;
}

.feature-chip.active {
  border-color: #f5c842;
  background: rgba(245, 200, 66, 0.12);
}

.feature-type-dot {
  width: 7px;
  height: 7px;
  border-radius: 50%;
  flex-shrink: 0;
}

.feature-detail-card {
  padding-top: 1rem;
  border-top: 1px solid rgba(148, 163, 184, 0.22);
}

.feature-detail-grid {
  margin-top: 0.65rem;
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(190px, 1fr));
  gap: 0.5rem;
  font-size: 0.83rem;
}

/* Tripartite Ethical Contract */
.ethical-contract-box {
  padding-top: 1.25rem;
  border-top: 1px solid rgba(148, 163, 184, 0.22);
}

.ethical-contract-box h3 {
  margin: 0;
  font-size: 1.05rem;
}

.ethical-steps {
  margin-top: 0.85rem;
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(230px, 1fr));
  gap: 1rem;
}

.ethical-step {
  padding-top: 0.5rem;
  border-top: 2px solid rgba(148, 163, 184, 0.25);
}

.ethical-step p {
  margin: 0.4rem 0;
  font-size: 0.85rem;
}

.ethical-tag {
  font-size: 0.76rem;
  font-weight: 700;
}

.tag-dato {
  color: #38bdf8;
}

.tag-interpretacion {
  color: #fbbf24;
}

.tag-sugerencia {
  color: #2e9e5b;
}

/* Federated Compare View */
.domain-pills-bar {
  margin-top: 1rem;
  display: flex;
  align-items: center;
  gap: 0.45rem;
  flex-wrap: wrap;
}

.compare-grid {
  margin-top: 1.25rem;
  padding-top: 1.25rem;
  border-top: 1px solid rgba(148, 163, 184, 0.2);
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
  gap: 1.5rem;
}

.compare-col-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 0.75rem;
  padding-bottom: 0.65rem;
  border-bottom: 1px solid rgba(148, 163, 184, 0.2);
}

.compare-select {
  padding: 0.35rem 0.6rem;
  border-radius: 6px;
  border: 1px solid rgba(148, 163, 184, 0.35);
  background: transparent;
  color: inherit;
  font-size: 0.82rem;
}

.compare-summary-row {
  margin: 0.75rem 0;
  display: flex;
  align-items: center;
  justify-content: space-between;
  font-size: 0.85rem;
}

.sovereignty-notice {
  margin-top: 0.65rem;
  padding: 0.85rem;
  border-radius: 6px;
  border: 1px dashed rgba(148, 163, 184, 0.35);
  font-size: 0.84rem;
  opacity: 0.85;
}

/* Traceability & Evidencias Panel */
.idempotency-log {
  margin-top: 1rem;
  padding: 0.65rem 0.85rem;
  border-radius: var(--radius-sm, 6px);
  border: 1px solid var(--status-aprobado-border, #10b981);
  background: var(--status-aprobado-bg, #d1fae5);
  color: var(--status-aprobado-text, #065f46);
}

.trace-evidencias-grid {
  margin-top: 1.25rem;
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 1.5rem;
  align-items: start;
}

@media (max-width: 900px) {
  .trace-evidencias-grid {
    grid-template-columns: 1fr;
  }
}

.events-stream {
  margin-top: 0.75rem;
  display: flex;
  flex-direction: column;
  gap: 0.65rem;
  max-height: 440px;
  overflow-y: auto;
}

.event-row {
  padding: 0.75rem 0;
  border-bottom: 1px solid rgba(148, 163, 184, 0.2);
}

.event-row-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 0.5rem;
  font-size: 0.85rem;
}

.event-row-meta {
  margin-top: 0.25rem;
  display: flex;
  gap: 0.45rem;
  font-size: 0.76rem;
  opacity: 0.75;
}

.event-payload {
  margin-top: 0.4rem;
  padding: 0.45rem 0.6rem;
  font-size: 0.76rem;
}

/* Shared Lists, Filter Controls & Forms */
.filter-group {
  display: flex;
  gap: 0.35rem;
  flex-wrap: wrap;
}

.btn-filter {
  padding: 0.4rem 0.75rem;
  border-radius: var(--radius-sm, 6px);
  border: 1px solid var(--color-border-default);
  background: var(--color-bg-elevated);
  color: var(--color-text-secondary);
  font-size: 0.8rem;
  font-weight: 500;
  cursor: pointer;
  white-space: nowrap;
  transition: border-color var(--duration-fast) var(--ease-out-expo),
    background-color var(--duration-fast) var(--ease-out-expo),
    color var(--duration-fast) var(--ease-out-expo);
}

.btn-filter.active {
  background: var(--color-accent-primary, #c2410c);
  border-color: var(--color-accent-primary, #c2410c);
  color: #ffffff;
  font-weight: 600;
}

.territory-list {
  list-style: none;
  padding: 0;
  margin: 0.85rem 0 0;
  display: flex;
  flex-direction: column;
}

.territory-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 1rem;
  padding: 0.85rem 0;
  border-bottom: 1px solid rgba(148, 163, 184, 0.18);
}

.territory-info {
  display: flex;
  flex-direction: column;
  gap: 0.22rem;
}

.territory-name {
  font-weight: 600;
  font-size: 0.95rem;
}

.territory-meta {
  font-size: 0.81rem;
  opacity: 0.78;
}

.territory-actions {
  display: flex;
  align-items: center;
  gap: 0.45rem;
  flex-shrink: 0;
}

.btn-toggle {
  padding: 0.4rem 0.75rem;
  border-radius: var(--radius-sm, 6px);
  border: 1px solid var(--color-border-default);
  background: var(--color-bg-elevated);
  color: var(--color-text-primary);
  font-size: 0.78rem;
  font-weight: 500;
  cursor: pointer;
  white-space: nowrap;
  transition: border-color var(--duration-fast) var(--ease-out-expo),
    background-color var(--duration-fast) var(--ease-out-expo);
}

.btn-toggle:hover,
.btn-filter:hover {
  border-color: var(--color-border-strong);
}

.territory-form {
  margin-top: 1rem;
  padding-top: 1rem;
  border-top: 1px solid var(--color-border-hairline);
  display: flex;
  gap: 0.5rem;
  flex-wrap: wrap;
}

.territory-form input {
  flex: 1 1 180px;
  padding: 0.5rem 0.75rem;
  border-radius: var(--radius-sm, 6px);
  border: 1px solid var(--color-border-default);
  background: var(--color-bg-inset, #f4f0e6);
  color: var(--color-text-primary);
  font-size: 0.86rem;
}

.territory-form button {
  padding: 0.5rem 1rem;
  border-radius: var(--radius-sm, 6px);
  border: 1px solid var(--color-accent-primary, #c2410c);
  background: var(--color-accent-primary, #c2410c);
  color: #ffffff;
  font-weight: 600;
  font-size: 0.86rem;
  cursor: pointer;
  white-space: nowrap;
  transition: background-color var(--duration-fast) var(--ease-out-expo);
}

.territory-form button:hover:not(:disabled) {
  background: var(--color-accent-primary-hover, #9a3412);
}

.territory-form button:disabled {
  opacity: 0.6;
  cursor: not-allowed;
}

.form-field {
  margin-top: 0.85rem;
  display: flex;
  flex-direction: column;
  gap: 0.35rem;
  font-size: 0.84rem;
}

.form-field select,
.form-field textarea {
  padding: 0.5rem 0.65rem;
  border-radius: var(--radius-sm, 6px);
  border: 1px solid var(--color-border-default);
  background: var(--color-bg-inset, #f4f0e6);
  color: var(--color-text-primary);
  font-family: inherit;
  font-size: 0.86rem;
}

.picker-svg {
  width: 100%;
  height: 110px;
  border-radius: var(--radius-sm, 6px);
  border: 1px solid var(--color-border-default);
  cursor: crosshair;
}

.empty-state {
  margin: 1rem 0 0;
  color: var(--color-text-muted);
  font-size: 0.9rem;
}

pre {
  margin: 0.65rem 0 0;
  padding: 0.75rem;
  border-radius: var(--radius-md, 10px);
  background: var(--color-bg-inset, #f4f0e6);
  border: 1px solid var(--color-border-hairline);
  color: var(--color-text-primary);
  overflow-x: auto;
  font-size: 0.82rem;
  font-family: var(--font-mono, 'JetBrains Mono', monospace);
}

.ok {
  color: var(--status-aprobado-text, #065f46);
  font-weight: 600;
}

.error {
  color: var(--status-rechazado-text, #991b1b);
  font-weight: 600;
}

.hint {
  color: var(--color-text-secondary);
  font-size: 0.88rem;
}

footer {
  margin-top: 2.5rem;
  padding-top: 1.25rem;
  border-top: 1px solid var(--color-border-default);
  color: var(--color-text-muted);
  font-size: 0.84rem;
}

code {
  font-family: var(--font-mono, 'JetBrains Mono', monospace);
  background: var(--color-bg-subtle, #e9e2d4);
  color: var(--color-text-primary);
  padding: 0.1rem 0.35rem;
  border-radius: var(--radius-xs, 4px);
  font-size: 0.82em;
}

.quota-banner {
  background: #fffbeb;
  border-bottom: 1px solid #fde68a;
  color: #78350f;
  padding: 0.65rem 1rem;
  font-size: 0.85rem;
  text-align: center;
  position: sticky;
  top: 0;
  z-index: 50;
  width: 100%;
}

.quota-banner a {
  text-decoration: underline;
  font-weight: 600;
  color: #451a03;
}

.map-wrapper {
  position: relative;
  width: 100%;
  height: 440px;
  margin-top: 1rem;
  border-radius: 10px;
  overflow: hidden;
  border: 1px solid rgba(148, 163, 184, 0.25);
}

.map-status-pill {
  position: absolute;
  top: 12px;
  left: 12px;
  z-index: 10;
  background: rgba(15, 23, 42, 0.88);
  color: #ffffff;
  padding: 0.35rem 0.75rem;
  border-radius: 6px;
  font-size: 0.78rem;
}

/* Custom Map Layer Control UI (MapControl inside TerritoriosMap) */
.layer-color-dot {
  display: inline-block;
  width: 8px;
  height: 8px;
  border-radius: 50%;
  margin-right: 0.4rem;
  vertical-align: middle;
}

.map-layer-control-card {
  margin: 12px;
  padding: 0.7rem 0.85rem;
  min-width: 245px;
  border-radius: 8px;
  background: rgba(15, 23, 42, 0.92);
  color: #f8fafc;
  border: 1px solid rgba(148, 163, 184, 0.35);
  backdrop-filter: blur(8px);
  font-family: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, sans-serif;
  display: flex;
  flex-direction: column;
  gap: 0.55rem;
}

.map-layer-control-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 0.5rem;
  padding-bottom: 0.4rem;
  border-bottom: 1px solid rgba(148, 163, 184, 0.22);
}

.map-layer-control-title {
  font-size: 0.76rem;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.04em;
  color: #e2e8f0;
}

.map-layer-control-count {
  font-size: 0.72rem;
  color: #94a3b8;
}

.map-layer-toggle-list {
  display: flex;
  flex-direction: column;
  gap: 0.35rem;
}

.map-layer-toggle-item {
  display: flex;
  align-items: center;
  gap: 0.4rem;
  padding: 0.32rem 0.45rem;
  border-radius: 6px;
  border: 1px solid rgba(148, 163, 184, 0.2);
  background: rgba(30, 41, 59, 0.55);
  cursor: pointer;
  font-size: 0.79rem;
  user-select: none;
}

.map-layer-toggle-item.active {
  border-color: rgba(46, 158, 91, 0.65);
  background: rgba(46, 158, 91, 0.14);
}

.map-layer-toggle-item input[type='checkbox'] {
  margin: 0;
  accent-color: #2e9e5b;
  cursor: pointer;
}

.map-layer-toggle-label {
  flex: 1;
  font-weight: 500;
  color: #f1f5f9;
}

.map-layer-toggle-badge {
  font-size: 0.72rem;
  font-weight: 700;
  color: #cbd5e1;
}

.map-layer-control-actions {
  display: flex;
  justify-content: space-between;
  gap: 0.4rem;
  padding-top: 0.35rem;
  border-top: 1px solid rgba(148, 163, 184, 0.2);
}

.map-layer-mini-btn {
  flex: 1;
  padding: 0.25rem 0.45rem;
  border-radius: 5px;
  border: 1px solid rgba(148, 163, 184, 0.32);
  background: transparent;
  color: #e2e8f0;
  font-size: 0.72rem;
  cursor: pointer;
}

.map-layer-mini-btn:hover {
  border-color: rgba(148, 163, 184, 0.75);
  background: rgba(148, 163, 184, 0.12);
}

.auth-box {
  margin-top: 1rem;
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: 0.75rem;
}

.user-bar {
  display: flex;
  align-items: center;
  gap: 0.6rem;
}

.user-email {
  font-size: 0.82rem;
  opacity: 0.8;
}

.workspace-grid {
  margin-top: 1rem;
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(340px, 1fr));
  gap: 1.5rem;
}

.workspace-Pane h3 {
  margin: 0 0 0.6rem;
  font-size: 0.95rem;
}

.pane-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 0.75rem;
  flex-wrap: wrap;
}

.search-row {
  display: flex;
  gap: 0.4rem;
}

.search-row input {
  padding: 0.35rem 0.65rem;
  border-radius: 6px;
  border: 1px solid rgba(148, 163, 184, 0.35);
  background: rgba(15, 23, 42, 0.15);
  color: inherit;
  font-size: 0.82rem;
}

.link-btn {
  text-decoration: none;
}

.btn-danger {
  color: #dc2626;
  border-color: rgba(220, 38, 38, 0.4);
}

.doc-viewer {
  margin-top: 1rem;
  padding-top: 1rem;
  border-top: 1px solid rgba(148, 163, 184, 0.25);
}

.doc-content {
  max-height: 240px;
  overflow-y: auto;
  white-space: pre-wrap;
}

/* Federated Sync Engine Panel */
.sync-engine-card {
  border-color: rgba(56, 189, 248, 0.35);
}

.sync-status-strip {
  margin-top: 1.15rem;
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(175px, 1fr));
  gap: 1rem;
  padding: 0.9rem 1rem;
  border-radius: 8px;
  background: rgba(15, 23, 42, 0.04);
  border: 1px solid rgba(148, 163, 184, 0.22);
}

@media (prefers-color-scheme: dark) {
  .sync-status-strip {
    background: rgba(30, 41, 59, 0.55);
  }
}

.sync-status-item {
  display: flex;
  flex-direction: column;
  gap: 0.2rem;
}

.sync-status-item strong {
  font-size: 0.95rem;
  display: flex;
  align-items: center;
  gap: 0.4rem;
}

.sync-status-dot {
  display: inline-block;
  width: 8px;
  height: 8px;
  border-radius: 50%;
}

.dot-online {
  background: #10b981;
}

.dot-offline {
  background: #f59e0b;
}

.sync-engine-grid {
  margin-top: 1.35rem;
  display: grid;
  grid-template-columns: 1.15fr 1fr;
  gap: 1.5rem;
  align-items: start;
}

@media (max-width: 920px) {
  .sync-engine-grid {
    grid-template-columns: 1fr;
  }
}

.sync-queue-col,
.sync-export-col {
  display: flex;
  flex-direction: column;
}

.sync-col-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 0.5rem;
  padding-bottom: 0.5rem;
  border-bottom: 1px solid rgba(148, 163, 184, 0.22);
}

.sync-col-header h3 {
  margin: 0;
  font-size: 0.98rem;
}

.sync-queue-list {
  list-style: none;
  padding: 0;
  margin: 0.65rem 0 0;
  display: flex;
  flex-direction: column;
  gap: 0.55rem;
  max-height: 290px;
  overflow-y: auto;
}

.sync-queue-item {
  padding: 0.65rem 0.75rem;
  border-radius: 6px;
  border: 1px solid rgba(148, 163, 184, 0.22);
  display: flex;
  flex-direction: column;
  gap: 0.25rem;
}

.sync-queue-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 0.5rem;
  font-size: 0.84rem;
}

.sync-queue-status {
  font-size: 0.75rem;
  font-weight: 700;
}

.status-queued {
  color: #f59e0b;
}

.status-syncing {
  color: #38bdf8;
}

.status-synced {
  color: #10b981;
}

.status-error {
  color: #ef4444;
}

.sync-queue-meta {
  display: flex;
  align-items: center;
  gap: 0.45rem;
  flex-wrap: wrap;
  font-size: 0.76rem;
  opacity: 0.8;
}

.export-actions-stack {
  margin-top: 0.85rem;
  display: flex;
  flex-direction: column;
  gap: 0.75rem;
}

.export-action-box {
  padding: 0.85rem 1rem;
  border-radius: 8px;
  border: 1px solid rgba(148, 163, 184, 0.22);
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 1rem;
  flex-wrap: wrap;
}

.export-action-box p {
  margin: 0.25rem 0 0;
}

.btn-primary-action {
  background: var(--color-accent-primary, #c2410c);
  border-color: var(--color-accent-primary, #c2410c);
  color: #ffffff;
  font-weight: 600;
}

.btn-primary-action:hover {
  background: var(--color-accent-primary-hover, #9a3412);
}

.drive-export-Feedback {
  margin-top: 0.85rem;
  padding: 0.75rem 0.9rem;
  border-radius: 6px;
  border: 1px solid rgba(46, 158, 91, 0.4);
  background: rgba(46, 158, 91, 0.08);
  display: flex;
  flex-direction: column;
  gap: 0.45rem;
  font-size: 0.85rem;
}

.drive-export-actions {
  display: flex;
  gap: 0.5rem;
  flex-wrap: wrap;
}

/* Federated Dossier Print Sheet (Visible on screen toggle + @media print) */
.dossier-print-sheet {
  margin-top: 1.5rem;
  padding: 2rem;
  border-radius: 10px;
  background: #ffffff;
  color: #0f172a;
  border: 2px solid #0f172a;
}

.dossier-sheet-header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 1.25rem;
  padding-bottom: 1rem;
  border-bottom: 2px solid #0f172a;
  flex-wrap: wrap;
}

.dossier-kicker {
  display: block;
  font-size: 0.72rem;
  font-weight: 700;
  letter-spacing: 0.06em;
  color: #9a3412;
  margin-bottom: 0.25rem;
}

.dossier-sheet-header h2 {
  margin: 0;
  font-size: 1.35rem;
  color: #0f172a;
}

.dossier-sheet-header p {
  margin: 0.25rem 0 0;
  font-size: 0.85rem;
  color: #334155;
}

.dossier-sheet-meta {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 0.35rem;
  font-size: 0.78rem;
  color: #334155;
}

.dossier-section {
  margin-top: 1.35rem;
}

.dossier-section h3 {
  margin: 0 0 0.6rem;
  font-size: 0.98rem;
  color: #0f172a;
  border-bottom: 1px solid #cbd5e1;
  padding-bottom: 0.3rem;
}

.dossier-kpi-row {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
  gap: 0.75rem;
}

.dossier-kpi {
  padding: 0.65rem 0.75rem;
  border: 1px solid #cbd5e1;
  border-radius: 6px;
  display: flex;
  flex-direction: column;
}

.dossier-kpi strong {
  font-size: 1.2rem;
  color: #0f172a;
}

.dossier-kpi span {
  font-size: 0.74rem;
  color: #475569;
}

.dossier-table {
  width: 100%;
  border-collapse: collapse;
  font-size: 0.81rem;
}

.dossier-table th,
.dossier-table td {
  text-align: left;
  padding: 0.45rem 0.55rem;
  border-bottom: 1px solid #e2e8f0;
  color: #1e293b;
}

.dossier-table th {
  font-weight: 700;
  background: #f8fafc;
}

.dossier-ethical-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
  gap: 0.85rem;
  font-size: 0.83rem;
}

.dossier-ethical-grid > div {
  padding: 0.75rem;
  border: 1px solid #cbd5e1;
  border-radius: 6px;
  background: #f8fafc;
}

.dossier-ethical-grid p {
  margin: 0.35rem 0 0;
  color: #1e293b;
}

.dossier-signature-footer {
  margin-top: 1.5rem;
  padding-top: 1rem;
  border-top: 1px dashed #64748b;
  display: flex;
  justify-content: space-between;
  gap: 1rem;
  flex-wrap: wrap;
  font-size: 0.82rem;
  color: #334155;
}

.dossier-signature-footer p {
  margin: 0.25rem 0 0;
}

@media print {
  .top-bar,
  .hero-banner,
  .quota-banner,
  main.container > section.card:not(#sincronizacion),
  .sync-engine-card > .section-header,
  .sync-status-strip,
  .sync-engine-grid,
  .dossier-print-hide,
  footer {
    display: none !important;
  }

  body,
  main.container,
  .sync-engine-card {
    background: #ffffff !important;
    color: #000000 !important;
    margin: 0 !important;
    padding: 0 !important;
    border: none !important;
  }

  .dossier-print-sheet {
    display: block !important;
    margin: 0 !important;
    padding: 0.5cm !important;
    border: none !important;
  }
}

/* EV-007..018 Audit & Verification Center */
.audit-ev-card {
  border-color: rgba(16, 185, 129, 0.4);
}

.audit-summary-strip {
  margin-top: 1.15rem;
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
  gap: 1rem;
  padding: 0.85rem 1rem;
  border-radius: 8px;
  background: rgba(16, 185, 129, 0.06);
  border: 1px solid rgba(16, 185, 129, 0.25);
}

.audit-summary-item {
  display: flex;
  flex-direction: column;
  gap: 0.2rem;
}

.audit-summary-item strong {
  font-size: 1rem;
}

.audit-domain-group {
  margin-top: 1.25rem;
}

.audit-domain-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 0.5rem;
  padding-bottom: 0.4rem;
  border-bottom: 1px solid rgba(148, 163, 184, 0.24);
}

.audit-domain-header h3 {
  margin: 0;
  font-size: 0.96rem;
}

.audit-table-wrap {
  overflow-x: auto;
  margin-top: 0.45rem;
}

.audit-ev-table {
  width: 100%;
  border-collapse: collapse;
  font-size: 0.82rem;
}

.audit-ev-table th,
.audit-ev-table td {
  text-align: left;
  padding: 0.55rem 0.65rem;
  border-bottom: 1px solid rgba(148, 163, 184, 0.18);
  vertical-align: top;
}

.audit-ev-table th {
  font-size: 0.74rem;
  text-transform: uppercase;
  letter-spacing: 0.04em;
  opacity: 0.75;
}

.audit-badge-verified {
  display: inline-block;
  padding: 0.15rem 0.5rem;
  border-radius: var(--radius-xs, 4px);
  font-size: var(--text-xs, 0.75rem);
  font-weight: 700;
  background: var(--status-aprobado-bg, #d1fae5);
  color: var(--status-aprobado-text, #065f46);
  border: 1px solid var(--status-aprobado-border, #10b981);
}

/* H2 Phase 1 — Persistent Ethical Store & Human Review Signing Panel */
.ethical-store-card {
  border-color: rgba(46, 158, 91, 0.42);
}

.ethical-mode-badge {
  padding: 0.3rem 0.65rem;
  border-radius: var(--radius-xs, 4px);
  font-size: var(--text-xs, 0.75rem);
  font-weight: 700;
  border: 1px solid var(--color-border-default);
}

.mode-live {
  background: var(--status-aprobado-bg, #d1fae5);
  border-color: var(--status-aprobado-border, #10b981);
  color: var(--status-aprobado-text, #065f46);
}

.mode-offline {
  background: var(--status-propuesto-bg, #fef3c7);
  border-color: var(--status-propuesto-border, #f59e0b);
  color: var(--status-propuesto-text, #92400e);
}

.ethical-signing-bar {
  margin-top: 1.15rem;
  padding: 1rem;
  border-radius: 8px;
  background: rgba(15, 23, 42, 0.04);
  border: 1px solid rgba(148, 163, 184, 0.22);
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
  gap: 1rem;
}

@media (prefers-color-scheme: dark) {
  .ethical-signing-bar {
    background: rgba(30, 41, 59, 0.55);
  }
}

.signing-field {
  display: flex;
  flex-direction: column;
  gap: 0.3rem;
}

.signing-field input {
  padding: 0.45rem 0.65rem;
  border-radius: 6px;
  border: 1px solid rgba(148, 163, 184, 0.35);
  background: transparent;
  color: inherit;
  font-size: 0.84rem;
}

.ethical-proposals-grid {
  margin-top: 1.25rem;
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(340px, 1fr));
  gap: 1.25rem;
}

.ethical-proposal-card {
  padding: 1.15rem;
  border-radius: 8px;
  border: 1px solid rgba(148, 163, 184, 0.26);
  display: flex;
  flex-direction: column;
  gap: 0.85rem;
}

.proposal-status-approved {
  border-color: rgba(16, 185, 129, 0.55);
  background: rgba(16, 185, 129, 0.04);
}

.proposal-status-rejected {
  border-color: rgba(239, 68, 68, 0.45);
  background: rgba(239, 68, 68, 0.04);
}

.proposal-card-header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 0.75rem;
  padding-bottom: 0.65rem;
  border-bottom: 1px solid rgba(148, 163, 184, 0.2);
}

.proposal-status-pill {
  padding: 0.25rem 0.55rem;
  border-radius: var(--radius-xs, 4px);
  font-size: var(--text-xs, 0.75rem);
  font-weight: 700;
  white-space: nowrap;
}

.pill-pending_human_review {
  background: var(--status-propuesto-bg, #fef3c7);
  color: var(--status-propuesto-text, #92400e);
  border: 1px solid var(--status-propuesto-border, #f59e0b);
}

.pill-approved {
  background: var(--status-aprobado-bg, #d1fae5);
  color: var(--status-aprobado-text, #065f46);
  border: 1px solid var(--status-aprobado-border, #10b981);
}

.pill-rejected {
  background: var(--status-rechazado-bg, #fee2e2);
  color: var(--status-rechazado-text, #991b1b);
  border: 1px solid var(--status-rechazado-border, #ef4444);
}

.proposal-tripartite-stack {
  display: flex;
  flex-direction: column;
  gap: 0.65rem;
}

.proposal-layer {
  padding: 0.65rem 0.75rem;
  border-radius: 6px;
  background: rgba(148, 163, 184, 0.06);
  border-left: 3px solid rgba(148, 163, 184, 0.45);
}

.proposal-layer p {
  margin: 0.3rem 0;
  font-size: 0.84rem;
}

.proposal-signature-seal {
  padding: 0.75rem;
  border-radius: 6px;
  background: rgba(16, 185, 129, 0.08);
  border: 1px dashed rgba(16, 185, 129, 0.45);
  display: flex;
  flex-direction: column;
  gap: 0.25rem;
  font-size: 0.8rem;
}

.proposal-action-row {
  margin-top: auto;
  padding-top: 0.65rem;
  border-top: 1px solid rgba(148, 163, 184, 0.18);
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 0.75rem;
  flex-wrap: wrap;
}

.proposal-buttons {
  display: flex;
  gap: 0.45rem;
  flex-wrap: wrap;
}

.ethical-audit-trail-box {
  margin-top: 1.5rem;
  padding-top: 1.15rem;
  border-top: 1px solid rgba(148, 163, 184, 0.24);
}

.ethical-audit-trail-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 0.5rem;
  margin-bottom: 0.65rem;
}

.ethical-audit-trail-header h3 {
  margin: 0;
  font-size: 0.96rem;
}

.ethical-audit-list {
  list-style: none;
  padding: 0;
  margin: 0;
  display: flex;
  flex-direction: column;
  gap: 0.45rem;
}

.ethical-audit-item {
  padding: 0.55rem 0.75rem;
  border-radius: 6px;
  border: 1px solid rgba(148, 163, 184, 0.2);
  display: flex;
  flex-direction: column;
  gap: 0.2rem;
  font-size: 0.81rem;
}

.ethical-audit-main {
  display: flex;
  align-items: center;
  gap: 0.45rem;
  flex-wrap: wrap;
}

.ethical-audit-meta {
  display: flex;
  align-items: center;
  gap: 0.4rem;
  flex-wrap: wrap;
  font-size: 0.75rem;
  opacity: 0.78;
}

/* ============================================================================
 * FASE C — Centro de Operaciones e Inteligencia Territorial Asistida (HITUB)
 * ============================================================================ */

.ops-hub-card {
  border: 1px solid rgba(194, 65, 12, 0.35);
  background: linear-gradient(
    180deg,
    rgba(255, 251, 235, 0.55) 0%,
    rgba(255, 255, 255, 0.95) 100%
  );
}

@media (prefers-color-scheme: dark) {
  .ops-hub-card {
    background: linear-gradient(
      180deg,
      rgba(30, 41, 59, 0.82) 0%,
      rgba(15, 23, 42, 0.94) 100%
    );
    border-color: rgba(234, 88, 12, 0.4);
  }
}

.ops-kpi-ribbon {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(185px, 1fr));
  gap: 0.85rem;
  margin: 1.15rem 0 1.35rem;
}

.ops-kpi-tile {
  padding: 0.85rem 1rem;
  border-radius: 10px;
  background: rgba(148, 163, 184, 0.08);
  border: 1px solid rgba(148, 163, 184, 0.22);
  display: flex;
  flex-direction: column;
  gap: 0.25rem;
}

.ops-kpi-tile strong {
  font-size: 1.35rem;
  line-height: 1.15;
}

.ops-kpi-sub {
  font-size: 0.75rem;
  opacity: 0.78;
}

/* Tabs Navigation */
.ops-tabs-nav {
  display: flex;
  gap: 0.5rem;
  flex-wrap: wrap;
  padding-bottom: 0.85rem;
  border-bottom: 1px solid rgba(148, 163, 184, 0.24);
  margin-bottom: 1.25rem;
}

.ops-tab-btn {
  padding: 0.55rem 0.95rem;
  border-radius: 8px;
  border: 1px solid rgba(148, 163, 184, 0.28);
  background: rgba(148, 163, 184, 0.06);
  color: inherit;
  font-size: 0.83rem;
  font-weight: 600;
  cursor: pointer;
  transition: all 0.15s ease;
}

.ops-tab-btn:hover {
  border-color: rgba(194, 65, 12, 0.55);
}

.ops-tab-btn.active {
  background: #c2410c;
  color: #ffffff;
  border-color: #c2410c;
}

.ops-pane {
  display: flex;
  flex-direction: column;
  gap: 1.1rem;
}

.ops-toolbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 0.85rem;
  flex-wrap: wrap;
}

.ops-search-box {
  flex: 1;
  min-width: 240px;
}

.ops-search-input {
  width: 100%;
  padding: 0.55rem 0.85rem;
  border-radius: 8px;
  border: 1px solid rgba(148, 163, 184, 0.35);
  background: rgba(148, 163, 184, 0.06);
  color: inherit;
  font-size: 0.85rem;
}

/* Matrix Grid */
.ops-matrix-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
  gap: 1rem;
}

.ops-node-card {
  padding: 1rem 1.1rem;
  border-radius: 10px;
  border: 1px solid rgba(148, 163, 184, 0.24);
  background: rgba(148, 163, 184, 0.04);
  display: flex;
  flex-direction: column;
  gap: 0.75rem;
  transition: border-color 0.15s ease, transform 0.15s ease;
}

.ops-node-card.selected {
  border-color: #c2410c;
  box-shadow: 0 0 0 1px rgba(194, 65, 12, 0.35);
}

.ops-node-card-top {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 0.75rem;
}

.ops-node-title-row {
  display: flex;
  align-items: center;
  gap: 0.45rem;
}

.ops-readiness-ring {
  padding: 0.25rem 0.55rem;
  border-radius: var(--radius-xs, 4px);
  border: 1px solid;
  font-size: var(--text-xs, 0.75rem);
  font-weight: 700;
}

.ops-bars-stack {
  display: flex;
  flex-direction: column;
  gap: 0.45rem;
}

.ops-bar-row {
  display: flex;
  flex-direction: column;
  gap: 0.2rem;
}

.ops-bar-labels {
  display: flex;
  justify-content: space-between;
  font-size: 0.76rem;
  opacity: 0.85;
}

.ops-bar-track {
  height: 6px;
  border-radius: 4px;
  background: rgba(148, 163, 184, 0.2);
  overflow: hidden;
}

.ops-bar-fill {
  height: 100%;
  border-radius: 4px;
  transition: width 0.3s ease;
}

.ops-node-metrics-mini {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 0.4rem;
  padding-top: 0.5rem;
  border-top: 1px solid rgba(148, 163, 184, 0.16);
  text-align: center;
}

.ops-node-metrics-mini > div {
  display: flex;
  flex-direction: column;
  font-size: 0.72rem;
}

.ops-node-metrics-mini strong {
  font-size: 0.92rem;
}

.ops-node-actions {
  display: flex;
  gap: 0.45rem;
  flex-wrap: wrap;
  margin-top: auto;
}

/* AI Synthesis Layout */
.ops-ai-layout {
  display: grid;
  grid-template-columns: 320px 1fr;
  gap: 1.25rem;
  align-items: start;
}

@media (max-width: 900px) {
  .ops-ai-layout {
    grid-template-columns: 1fr;
  }
}

.ops-ai-controls {
  padding: 1rem;
  border-radius: 10px;
  border: 1px solid rgba(148, 163, 184, 0.24);
  background: rgba(148, 163, 184, 0.05);
  display: flex;
  flex-direction: column;
  gap: 0.85rem;
}

.ops-ai-controls h3 {
  margin: 0;
  font-size: 0.98rem;
}

.ops-select {
  width: 100%;
  padding: 0.5rem 0.65rem;
  border-radius: 6px;
  border: 1px solid rgba(148, 163, 184, 0.35);
  background: rgba(15, 23, 42, 0.04);
  color: inherit;
  font-size: 0.84rem;
}

@media (prefers-color-scheme: dark) {
  .ops-select {
    background: rgba(15, 23, 42, 0.65);
  }
}

.ops-ai-guardrail-box {
  padding: 0.65rem 0.75rem;
  border-radius: 6px;
  border-left: 3px solid #f59e0b;
  background: rgba(245, 158, 11, 0.08);
  display: flex;
  flex-direction: column;
  gap: 0.25rem;
  font-size: 0.76rem;
}

.ops-ai-output {
  padding: 1.15rem;
  border-radius: 10px;
  border: 1px solid rgba(148, 163, 184, 0.26);
  background: rgba(148, 163, 184, 0.03);
  display: flex;
  flex-direction: column;
  gap: 1rem;
}

.ops-ai-output-header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 0.75rem;
  padding-bottom: 0.75rem;
  border-bottom: 1px solid rgba(148, 163, 184, 0.2);
}

.ops-ai-output-header h3 {
  margin: 0.15rem 0 0;
  font-size: 1.05rem;
}

.ops-ai-badge {
  padding: 0.25rem 0.6rem;
  border-radius: var(--radius-xs, 4px);
  font-size: var(--text-xs, 0.75rem);
  font-weight: 700;
  background: var(--status-propuesto-bg, #fef3c7);
  color: var(--status-propuesto-text, #92400e);
  border: 1px solid var(--status-propuesto-border, #f59e0b);
  white-space: nowrap;
}

.ops-ai-tripartite-cards {
  display: flex;
  flex-direction: column;
  gap: 0.75rem;
}

.ops-ai-layer {
  padding: 0.85rem 1rem;
  border-radius: 8px;
  background: rgba(148, 163, 184, 0.06);
  border-left: 4px solid #64748b;
  display: flex;
  flex-direction: column;
  gap: 0.35rem;
}

.ops-ai-layer p {
  margin: 0;
  font-size: 0.86rem;
  line-height: 1.5;
}

.layer-dato {
  border-left-color: #0ea5e9;
}

.layer-interpretacion {
  border-left-color: #f59e0b;
}

.layer-sugerencia {
  border-left-color: #10b981;
}

.ops-ai-footer-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 0.75rem;
  flex-wrap: wrap;
  padding-top: 0.65rem;
  border-top: 1px solid rgba(148, 163, 184, 0.2);
}

/* Catalog List */
.ops-catalog-list {
  display: flex;
  flex-direction: column;
  gap: 0.6rem;
}

.ops-catalog-row {
  padding: 0.75rem 0.95rem;
  border-radius: 8px;
  border: 1px solid rgba(148, 163, 184, 0.22);
  background: rgba(148, 163, 184, 0.03);
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 1rem;
  flex-wrap: wrap;
}

.ops-catalog-main {
  display: flex;
  flex-direction: column;
  gap: 0.25rem;
  flex: 1;
  min-width: 240px;
}

.ops-catalog-title {
  display: flex;
  align-items: center;
  gap: 0.45rem;
  flex-wrap: wrap;
  font-size: 0.88rem;
}

.ops-catalog-node-tag {
  padding: 0.12rem 0.45rem;
  border-radius: 4px;
  font-size: 0.72rem;
  font-weight: 600;
  background: rgba(148, 163, 184, 0.16);
}

.ops-catalog-desc {
  margin: 0;
  font-size: 0.8rem;
  opacity: 0.82;
}

.ops-catalog-meta {
  display: flex;
  align-items: center;
  gap: 0.6rem;
  flex-wrap: wrap;
}

/* Action Plan Form & Cards */
.ops-plan-form {
  padding: 1rem;
  border-radius: 10px;
  border: 1px solid rgba(148, 163, 184, 0.24);
  background: rgba(148, 163, 184, 0.04);
  display: flex;
  flex-direction: column;
  gap: 0.75rem;
}

.ops-plan-form h3 {
  margin: 0;
  font-size: 0.96rem;
}

.ops-plan-form-grid {
  display: grid;
  grid-template-columns: 2fr 1fr 1fr 1fr auto;
  gap: 0.6rem;
  align-items: center;
}

@media (max-width: 900px) {
  .ops-plan-form-grid {
    grid-template-columns: 1fr;
  }
}

.ops-plan-list {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
  gap: 0.85rem;
}

.ops-plan-card {
  padding: 0.95rem 1.05rem;
  border-radius: 8px;
  border: 1px solid rgba(148, 163, 184, 0.24);
  background: rgba(148, 163, 184, 0.03);
  display: flex;
  flex-direction: column;
  gap: 0.65rem;
}

.ops-plan-top {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 0.65rem;
}

.ops-priority-tag {
  padding: 0.18rem 0.5rem;
  border-radius: var(--radius-xs, 4px);
  font-size: var(--text-xs, 0.75rem);
  font-weight: 700;
  white-space: nowrap;
}

.prio-alta {
  background: var(--status-rechazado-bg, #fee2e2);
  color: var(--status-rechazado-text, #991b1b);
  border: 1px solid var(--status-rechazado-border, #ef4444);
}

.prio-media {
  background: var(--status-propuesto-bg, #fef3c7);
  color: var(--status-propuesto-text, #92400e);
  border: 1px solid var(--status-propuesto-border, #f59e0b);
}

.prio-baja {
  background: var(--status-observado-bg, #e0f2fe);
  color: var(--status-observado-text, #075985);
  border: 1px solid var(--status-observado-border, #0ea5e9);
}

.ops-plan-meta {
  display: flex;
  flex-direction: column;
  gap: 0.2rem;
  font-size: 0.77rem;
  opacity: 0.82;
}

.ops-plan-actions {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 0.5rem;
  padding-top: 0.5rem;
  border-top: 1px solid rgba(148, 163, 184, 0.16);
  margin-top: auto;
}

/* ==========================================================================
   Territorial Geocoder Search Bar & Custom InfoWindow Styles
   ========================================================================== */

.map-geocoder-overlay {
  position: absolute;
  top: 12px;
  left: 50%;
  transform: translateX(-50%);
  z-index: 15;
  width: min(560px, calc(100% - 280px));
  min-width: 280px;
  display: flex;
  flex-direction: column;
  gap: 0.35rem;
}

@media (max-width: 900px) {
  .map-geocoder-overlay {
    top: 52px;
    left: 12px;
    transform: none;
    width: calc(100% - 24px);
  }
}

.map-geocoder-form {
  display: flex;
  align-items: center;
  gap: 0.35rem;
  padding: 0.35rem 0.45rem;
  border-radius: 8px;
  background: rgba(15, 23, 42, 0.94);
  border: 1px solid rgba(148, 163, 184, 0.38);
  backdrop-filter: blur(8px);
  box-shadow: 0 4px 12px rgba(2, 6, 23, 0.35);
}

.map-geocoder-input {
  flex: 1;
  min-width: 0;
  padding: 0.38rem 0.55rem;
  border: 1px solid rgba(148, 163, 184, 0.25);
  border-radius: 6px;
  background: rgba(30, 41, 59, 0.85);
  color: #f8fafc;
  font-size: 0.8rem;
  font-family: inherit;
  outline: none;
}

.map-geocoder-input::placeholder {
  color: #94a3b8;
}

.map-geocoder-input:focus {
  border-color: #38bdf8;
}

.map-geocoder-btn {
  padding: 0.38rem 0.7rem;
  border-radius: 6px;
  border: 1px solid rgba(56, 189, 248, 0.45);
  background: #0284c7;
  color: #ffffff;
  font-size: 0.78rem;
  font-weight: 600;
  cursor: pointer;
  white-space: nowrap;
}

.map-geocoder-btn:hover:not(:disabled) {
  background: #0369a1;
}

.map-geocoder-btn:disabled {
  opacity: 0.6;
  cursor: wait;
}

.map-geocoder-clear-btn {
  padding: 0.32rem 0.5rem;
  border-radius: 6px;
  border: 1px solid rgba(148, 163, 184, 0.3);
  background: transparent;
  color: #cbd5e1;
  font-size: 0.75rem;
  cursor: pointer;
}

.map-geocoder-clear-btn:hover {
  background: rgba(148, 163, 184, 0.15);
  color: #ffffff;
}

.map-geocoder-error {
  padding: 0.4rem 0.65rem;
  border-radius: 6px;
  background: rgba(127, 29, 29, 0.94);
  border: 1px solid rgba(248, 113, 113, 0.5);
  color: #fecaca;
  font-size: 0.76rem;
}

.map-geocoder-results {
  list-style: none;
  margin: 0;
  padding: 0.3rem;
  border-radius: 8px;
  background: rgba(15, 23, 42, 0.96);
  border: 1px solid rgba(148, 163, 184, 0.38);
  max-height: 220px;
  overflow-y: auto;
  display: flex;
  flex-direction: column;
  gap: 0.25rem;
}

.map-geocoder-result-item {
  width: 100%;
  text-align: left;
  padding: 0.45rem 0.6rem;
  border-radius: 6px;
  border: 1px solid transparent;
  background: rgba(30, 41, 59, 0.65);
  color: #f1f5f9;
  cursor: pointer;
  display: flex;
  flex-direction: column;
  gap: 0.15rem;
}

.map-geocoder-result-item:hover {
  border-color: rgba(56, 189, 248, 0.55);
  background: rgba(30, 41, 59, 0.95);
}

.map-geocoder-result-address {
  font-size: 0.79rem;
  font-weight: 600;
  color: #f8fafc;
}

.map-geocoder-result-coords {
  font-size: 0.71rem;
  color: #94a3b8;
}

.map-infowindow-card {
  color: #0f172a;
  padding: 0.25rem 0.35rem;
  max-width: 280px;
  font-family: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, sans-serif;
  line-height: 1.4;
}

.map-infowindow-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 0.4rem;
  margin-bottom: 0.3rem;
}

.map-infowindow-badge {
  display: inline-block;
  padding: 0.12rem 0.45rem;
  border-radius: 4px;
  color: #ffffff;
  font-size: 0.68rem;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.03em;
}

.map-infowindow-id {
  font-size: 0.68rem;
  color: #64748b;
  font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
}

.map-infowindow-title {
  display: block;
  font-size: 0.92rem;
  font-weight: 700;
  color: #0f172a;
}

.map-infowindow-subtitle {
  font-size: 0.76rem;
  color: #475569;
  margin-bottom: 0.35rem;
}

.map-infowindow-focus {
  font-size: 0.78rem;
  color: #1e293b;
  background: #f1f5f9;
  padding: 0.35rem 0.45rem;
  border-radius: 5px;
  margin-bottom: 0.35rem;
}

.map-infowindow-meta {
  display: flex;
  flex-direction: column;
  gap: 0.15rem;
  font-size: 0.74rem;
  color: #334155;
  padding-top: 0.3rem;
  border-top: 1px solid #e2e8f0;
}

.map-infowindow-action-btn {
  margin-top: 0.45rem;
  width: 100%;
  padding: 0.35rem 0.55rem;
  border-radius: 5px;
  border: 1px solid #cbd5e1;
  background: #0f172a;
  color: #f8fafc;
  font-size: 0.74rem;
  font-weight: 600;
  cursor: pointer;
}

.map-infowindow-action-btn:hover {
  background: #1e293b;
}

/* ==========================================================================
   Territorial Reports Export Section (Google Drive API + firebase-applet-config)
   ========================================================================== */

.drive-reports-export-section {
  margin-top: 1.5rem;
  padding-top: 1.25rem;
  border-top: 1px solid rgba(148, 163, 184, 0.25);
}

.drive-reports-export-header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 1rem;
  flex-wrap: wrap;
}

.drive-reports-export-header h3 {
  margin: 0;
  font-size: 1.02rem;
}

.drive-reports-controls {
  display: flex;
  align-items: center;
  gap: 0.5rem;
  flex-wrap: wrap;
}

.drive-format-select {
  padding: 0.42rem 0.65rem;
  border-radius: 6px;
  border: 1px solid rgba(148, 163, 184, 0.38);
  background: rgba(15, 23, 42, 0.25);
  color: inherit;
  font-size: 0.8rem;
  font-family: inherit;
}

.drive-config-meta-strip {
  margin-top: 0.75rem;
  padding: 0.5rem 0.75rem;
  border-radius: 6px;
  background: rgba(15, 23, 42, 0.18);
  border: 1px solid rgba(148, 163, 184, 0.2);
  display: flex;
  align-items: center;
  gap: 0.6rem;
  flex-wrap: wrap;
  font-size: 0.76rem;
  color: #94a3b8;
}

.drive-export-banner {
  margin-top: 0.85rem;
  padding: 0.75rem 0.95rem;
  border-radius: 8px;
  background: rgba(22, 101, 52, 0.18);
  border: 1px solid rgba(34, 197, 94, 0.4);
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 0.75rem;
  flex-wrap: wrap;
  font-size: 0.82rem;
}

.drive-reports-table-wrap {
  margin-top: 0.85rem;
  overflow-x: auto;
}

.drive-reports-table {
  width: 100%;
  border-collapse: collapse;
  font-size: 0.82rem;
}

.drive-reports-table th,
.drive-reports-table td {
  padding: 0.6rem 0.65rem;
  text-align: left;
  border-bottom: 1px solid rgba(148, 163, 184, 0.18);
  vertical-align: middle;
}

.drive-reports-table th {
  font-size: 0.74rem;
  text-transform: uppercase;
  letter-spacing: 0.03em;
  color: #94a3b8;
  font-weight: 600;
}

.drive-report-status-pill {
  display: inline-block;
  padding: 0.15rem 0.45rem;
  border-radius: 4px;
  font-size: 0.72rem;
  font-weight: 600;
  background: rgba(148, 163, 184, 0.16);
}
