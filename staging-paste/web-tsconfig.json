{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "noEmit": true,
    "resolveJsonModule": true,
    "baseUrl": ".",
    "paths": {
      "@delocalsoy/contracts": ["../../packages/contracts/src/index.ts"],
      "@delocalsoy/domain": ["../../packages/domain/src/index.ts"],
      "@delocalsoy/events": ["../../packages/events/src/index.ts"]
    }
  },
  "include": [
    "src",
    "vite.config.ts",
    "../../firebase-applet-config.json"
  ]
}
