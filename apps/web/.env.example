# ── Dev server web (apps/web) — MONTAR-1 #442 ──
# Vite lee el .env de la RAÍZ del monorepo (envDir "../../"): API_URL,
# VITE_REAL_API y VITE_MOCK_API viven ahí. Este archivo documenta las
# variables que consume apps/web.

# URL de la API Express — destino del proxy /api/* del dev server cuando
# VITE_REAL_API=1. Sin ese flag, el middleware de staging sirve /api/* en
# memoria (staging sintético declarado) y API_URL no se usa.
API_URL=http://127.0.0.1:3001

# 1 = modo API REAL: proxy /api/* → API_URL y staging DESMONTADO (MONTAR-1 #442).
# 0 = staging sintético declarado (default, R15).
VITE_REAL_API=0

# Mock sintético del dev-server (R5, riesgo #54): solo para sandbox sin backend.
# 1 = respuestas sintéticas autodeclaradas (mode "synthetic").
# Sin backend y en 0: la UI muestra el error honesto «Sin conexión con la API».
VITE_MOCK_API=0

# Origen de datos del demo territorial (DEMO-3, #18, ADR-029):
# synthetic = literales locales 100% sintéticos (default, banner de honestidad)
# api        = backend real vía proxy /api (GET /api/territorios, /api/evidencias;
#              capas/categorías/features aún sin ruta → declaradas vacías, R15)
VITE_DATA_SOURCE=synthetic
