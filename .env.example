# DELocalSoy.AR — variables de entorno del monorepo (MONTAR-1 #442)
# Copiar a .env en la raíz del repo y ajustar. Guía completa paso a paso:
# README § «Puesta en marcha full-stack (Codespaces)».

# ── Infraestructura (docker-compose.yml) ──
DATABASE_URL=postgresql://delocalsoy:delocalsoy@localhost:5432/delocalsoy
REDIS_URL=redis://localhost:6379
POSTGRES_USER=delocalsoy
POSTGRES_PASSWORD=delocalsoy
POSTGRES_DB=delocalsoy

# ── API Express (apps/api) ──
# 3001: el dev server web YA ocupa el 3000 (vite --port 3000) — MONTAR-1 #442.
PORT=3001
API_URL=http://127.0.0.1:3001

# Identidad (R8 fail-closed): sin JWT_SECRET (>= 16 chars) el registro/login
# responde 503 «identidad no disponible» — JAMÁS abierta por defecto.
# Generar un secreto local: openssl rand -hex 32
JWT_SECRET=cambiar-por-un-secreto-de-16-chars-o-mas

# Codespaces (ADR-028): binding y hosts SOLO explícitos — descomentar dentro
# del Codespace. Sin estos valores, ambos servicios escuchan solo localhost.
# HOST=0.0.0.0
# ALLOWED_HOSTS=true

# ── Worker (apps/worker) — default entre paréntesis ──
# WORKER_INTERVAL_MS (5000)
# WORKER_STOP_AFTER_PASSES (0 = infinito)
# RECONCILE_INTERVAL_MS (60000)

# ── Dev server web (apps/web — vite lee este archivo vía envDir "../../") ──
# 1 = MODO API REAL (MONTAR-1 #442): el middleware de staging NO se monta y
#     /api/* se proxya a API_URL. Sin el flag (default 0) el staging sintético
#     declarado queda montado — comportamiento previo (R15: explícito).
VITE_REAL_API=0

# Mock sintético del dev-server (R5, riesgo #54): 1 = respuestas sintéticas
# autodeclaradas (mode "synthetic"). Sin backend y en 0, la UI muestra el error
# honesto «Sin conexión con la API».
VITE_MOCK_API=0
