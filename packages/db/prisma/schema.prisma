// DELocalSoy.AR — núcleo Track A v7.1
// Convenciones: ids `cuid`, columnas mapeadas a snake_case con @map(),
// `events_raw` con hash único para idempotencia.
//
// CORE-005 R2 (#206): autoría pseudonimizada del reporte ciudadano —
// created_by_hash = sha256(usuario_id) truncado (Ley 25.326, ADR-027).
// EXTENSIÓN CORE-002 (vocabulario del demo territorial federado v5.1):
// - nodos, capas por nodo, categorías de reporte, features sintéticos
// - reportes con flujo received → evaluating → in_progress → resolved
// - columna PostGIS `geom` en reportes/features (agregada por migración
//   versionada: Prisma no soporta tipos geometry nativamente)
//
// EXTENSIÓN CORE-004 (identidad por etapas, ADR-031):
// - usuarios con rol ciudadano | visitante | moderador | admin (ARTEFACTOS-ROLES
//   AR1 #400: visitante = cuenta ligera SOLO LECTURA v0.2; el vecino NO es rol —
//   es atributo de residencia, ver columnas AR1 del model usuarios)
// - sin PII en events_raw: sellos system.user_* solo con {usuario_id, rol}
// - R5b: activos territoriales propuestos por ciudadanos (pseudónimo, sin PII)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Eventos crudos del sistema (fuente de verdad, append-only, idempotentes).
model events_raw {
  id          String   @id @default(cuid())
  type        String   @map("type")
  payload     Json     @map("payload")
  hash        String   @unique @map("hash") // hash único → idempotencia
  occurred_at DateTime @map("occurred_at")
  ingested_at DateTime @default(now()) @map("ingested_at")

  @@map("events_raw")
}

/// Registro de evidencias ejecutables (EV-xxx).
model evidencias {
  id          String    @id @default(cuid())
  code        String    @unique @map("code") // e.g. "EV-001"
  title       String    @map("title")
  status      String    @default("pendiente") @map("status") // pendiente | ok | fallido
  result      Json?     @map("result")
  verified_at DateTime? @map("verified_at")

  @@map("evidencias")
}

/// Entidades territoriales mínimas del núcleo (PostGIS).
model territorios {
  id        String  @id @default(cuid())
  nombre    String  @map("nombre")
  provincia String  @map("provincia")
  activo    Boolean @default(true) @map("activo")

  /// Geometría puntual WGS84 (Aterrizaje PR 2 — issue #21).
  /// Prisma no tipa geometry: se administra vía SQL (migración + índice GiST).
  geom Unsupported("geometry(Point,4326)")?

  @@map("territorios")
}

// ─── CORE-002: vocabulario del demo territorial federado ───

/// Nodos federados del demo (Capital, Caucete, Iglesia).
model nodos {
  id         String  @id @default(cuid())
  key        String  @unique @map("key") // capital | caucete | iglesia
  nombre     String  @map("nombre")
  subtitle   String  @map("subtitle") // e.g. "Centro–Cívico–Desamparados"
  foco       String  @map("foco") // e.g. "Comercio y espacio público"
  centro_lat Float   @map("centro_lat")
  centro_lng Float   @map("centro_lng")
  poblacion  Int     @map("poblacion") // INDEC 2022, redondeado
  activo     Boolean @default(true) @map("activo")

  capas       capas[]
  categorias  categorias[]
  features    features[]
  reportes    reportes[]

  @@map("nodos")
}

/// Capas por nodo (catálogo explícito, no inferible en frontend).
model capas {
  id         String  @id @default(cuid())
  nodo_id    String  @map("nodo_id")
  key        String  @map("key") // e.g. "public_lighting"
  nombre     String  @map("nombre")
  dominio    String  @map("dominio") // assets | problems | public_space | health | community | production | tourism
  geometria  String  @map("geometria") // Point | LineString
  default_on Boolean @default(false) @map("default_on")

  nodo        nodos       @relation(fields: [nodo_id], references: [id], onDelete: Cascade)
  features    features[]
  categorias  categorias[]

  @@unique([nodo_id, key])
  @@map("capas")
}

/// Categorías de reporte por nodo (vocabulario local).
model categorias {
  id      String  @id @default(cuid())
  nodo_id String  @map("nodo_id")
  code    String  @map("code") // e.g. "insufficient_lighting"
  label   String  @map("label") // e.g. "Iluminación insuficiente"
  capa_id String? @map("capa_id")

  nodo nodos  @relation(fields: [nodo_id], references: [id], onDelete: Cascade)
  capa capas? @relation(fields: [capa_id], references: [id])

  @@unique([nodo_id, code])
  @@map("categorias")
}

/// Features territoriales (activos y problemáticas cartografiadas).
/// Datos sintéticos de diseño: is_synthetic = true hasta que exista relevamiento real.
model features {
  id           String   @id @default(cuid())
  nodo_id      String   @map("nodo_id")
  capa_id      String   @map("capa_id")
  titulo       String   @map("titulo")
  tipo         String   @map("tipo") // asset | problem
  estado       String   @map("estado") // verified | pending | community_validated | synthetic_demo | declared | disputed | in_execution | completed (NCAP-R5 #157: declared = anuncio sin verificación — R15; disputed = observación en disputa; VIG-010 #381: in_execution/completed = ciclo de obra declarada → en ejecución → completada)
  fuente_label String   @map("fuente_label") // siempre "Ilustrativa · <tipo>" en demo
  observado_at DateTime @map("observado_at")
  lat          Float    @map("lat")
  lng          Float    @map("lng")
  is_synthetic Boolean  @default(true) @map("is_synthetic")
  created_at   DateTime @default(now()) @map("created_at")

  /// Geometría puntal WGS84: columna + trigger + índice GiST en la migración
  /// versionada 20261007120000_core002_schema (Prisma no tipa geometry).
  geom Unsupported("geometry(Point,4326)")?

  nodo nodos @relation(fields: [nodo_id], references: [id], onDelete: Cascade)
  capa capas @relation(fields: [capa_id], references: [id], onDelete: Cascade)

  @@map("features")
}

/// Reportes territoriales con flujo received → evaluating → in_progress → resolved.
/// La columna PostGIS `geom` vive en la migración versionada (triggers lat/lng + GiST).
model reportes {
  id           String   @id @default(cuid())
  nodo_id      String   @map("nodo_id")
  categoria    String   @map("categoria") // code de categorias
  descripcion  String?  @map("descripcion")
  estado       String   @default("received") @map("estado") // ReporteEstadoSchema (CORE-005 R1, #206): received | evaluating | in_progress | resolved | descartado
  lat          Float    @map("lat")
  lng          Float    @map("lng")
  is_synthetic Boolean  @default(true) @map("is_synthetic")
  created_by_hash String?  @map("created_by_hash") // CORE-005 R2 (#206): sha256(usuario_id) truncado — Ley 25.326, ADR-027
  hash         String   @unique @map("hash") // idempotencia del reporte
  created_at   DateTime @default(now()) @map("created_at")
  updated_at   DateTime @updatedAt @map("updated_at")

  /// Geometría puntual WGS84: columna + trigger + índice GiST en la migración
  /// versionada 20261007120000_core002_schema (Prisma no tipa geometry).
  geom Unsupported("geometry(Point,4326)")?

  // VIG-011 (#378, épica #377): AMC — contexto de mediación del reporte.
  // Sin "dominio" la fila es un reporte legacy CORE-005 intacto (patrón
  // VIG-002: la escritura existente no cambia).
  subnodo_key     String?   @map("subnodo_key") // ancla territorial del AMC (subnodos VIG-001)
  dominio         String?   @map("dominio") // AmcDominioSchema: espacio_publico | infraestructura_vial | movilidad | agua_saneamiento | clima_ambiente | conectividad | servicios | produccion_rural | patrimonio
  tipo            String?   @map("tipo") // N3 de la taxonomía VIG-000 (opcional)
  canal_ingreso   String?   @map("canal_ingreso") // web | papel | whatsapp | presencial — 3 canales en paralelo desde el día 1
  mediador_ref    String?   @map("mediador_ref") // → mediadores.key (canal mediado, sin bot — R15)
  reportado_por   String?   @map("reportado_por") // alias comunitario — SOLO con consentimiento guarda_alias (ADR-027, Ley 25.326)
  consentimiento  Json?     @map("consentimiento") // ReporteAmcConsentimientoSchema — consentimiento granular
  precision       String?   @map("precision") // gps | referencial | aproximado
  riesgo_inmediato Boolean  @default(false) @map("riesgo_inmediato") // prioridad por riesgo declarado (VIG-011)
  observado_en    DateTime? @map("observado_en") // fecha del testimonio (carga diferida del mediador)
  cluster_key     String?   @map("cluster_key") // convergencia AMC: mismo dominio+categoría, ~500 m, 90 días

  nodo nodos @relation(fields: [nodo_id], references: [id], onDelete: Cascade)

  @@index([dominio])
  @@index([subnodo_key])
  @@index([cluster_key])

  @@map("reportes")
}

// ─── CORE-004: identidad por etapas (ADR-031, #87) ───

/// Usuarios con rol (ciudadano | moderador | admin). La contraseña vive solo
/// como hash scrypt en password_hash (node:crypto — cero dependencias nuevas).
/// events_raw registra sellos system.user_* sin PII (Ley 25.326, ADR-027).
model usuarios {
  id            String   @id @default(cuid())
  email         String   @unique @map("email")
  password_hash String   @map("password_hash") // scrypt$<salt hex>$<hash hex>
  rol           String   @default("ciudadano") @map("rol") // ciudadano | visitante (AR1 #400: cuenta ligera solo lectura v0.2) | moderador | admin
  display_name  String?  @map("display_name")
  // ARTEFACTOS-ROLES AR1 (#400, épica #399) — decisión DH 2026-11-06: vecino =
  // ATRIBUTO de residencia sobre la cuenta ciudadana, NO un rol. Ley 25.326 /
  // ADR-027: SIN domicilio jamás — solo la clave del subnodo real del
  // vocabulario (validada contra subnodos) y el timestamp de auto-declaración
  // (R15: sin verificación). La re-declaración renueva el atributo y sella
  // de nuevo (historial append-only en events_raw).
  residencia_subnodo_key   String?   @map("residencia_subnodo_key")
  residencia_declarada_en  DateTime? @map("residencia_declarada_en")
  // AR1: subnodo de tránsito DECLARADO del visitante (jamás geolocalizado,
  // Ley 25.326) + consentimiento granular {contacto_email: boolean} (ADR-027:
  // el alta visitante lo exige literal true, nunca pre-marcado en el cliente).
  transito_subnodo_key     String?   @map("transito_subnodo_key")
  consentimiento           Json?     @map("consentimiento")
  created_at    DateTime @default(now()) @map("created_at")
  updated_at    DateTime @updatedAt @map("updated_at")

  @@map("usuarios")
}

// ─── CORE-004 R4b: proyección del worker (ADR-032, #87) ───

/// Proyección derivada del worker — NO es fuente de verdad: events_raw manda.
/// event_id único → el re-consumo de una referencia es idempotente (P2002).
model event_projections {
  id           String   @id @default(cuid())
  event_id     String   @unique @map("event_id")
  event_type   String   @map("event_type")
  event_hash   String   @map("event_hash")
  projected_at DateTime @default(now()) @map("projected_at")

  @@map("event_projections")
}

// ─── CORE-004 R5b: dominio activos (#87) ───

/// Activos territoriales propuestos por la ciudadanía (escritura ciudadana
/// verificada). El autor queda como pseudónimo created_by_hash = sha256(usuario_id)
/// truncado — nunca PII en la tabla ni en los sellos (Ley 25.326, ADR-027).
/// Flujo de moderación: propuesto → aprobado | rechazado (+ archivado, VIG-002).
/// La columna PostGIS `geom` vive en la migración versionada
/// 20261008200000_r5b_activos (trigger lat/lng + índice GiST).
///
/// VIG-002 (NVIG-R2 #169, épica #167 — Opción A ratificada por la DH
/// 2026-10-13: extender el dominio, no duplicarlo):
/// - tipos multimodales: + local | prestador | experiencia | observacion
/// - subnodo_key: contexto de distrito/paraje (patrón oportunidades)
/// - lat/lng pasan a opcionales: el punto propio SOLO con fuente (R15) —
///   el POST ciudadano lo exige por contrato; la ingesta curada no inventa
/// - visibilidad ADR-036 (public | generalized | restricted): restricted se
///   excluye de la lectura pública (ficha sensible = custodia, VIG-004)
/// - procedencia ADR-035: aprobado con fuente trazable = "verificado"
/// - consentimiento granular (Ley 25.326) si el activo nombra a una persona
/// - is_synthetic: demo marcada, nunca publicada como real
/// - hash único opcional: idempotencia de la ingesta curada (seed-activo-*)
model activos {
  id              String   @id @default(cuid())
  tipo            String   @map("tipo") // ActivoTipoSchema: inmueble | infraestructura | servicio | patrimonio | local | prestador | experiencia | observacion | otro
  titulo          String   @map("titulo")
  descripcion     String?  @map("descripcion")
  estado          String   @default("propuesto") @map("estado") // propuesto | aprobado | rechazado | archivado
  nodo_key        String   @map("nodo_key") // capital | caucete | iglesia
  subnodo_key     String?  @map("subnodo_key") // sj_iglesia_* — contexto de distrito/paraje (VIG-002)
  lat             Float? // punto propio SOLO con fuente (R15): null = se acredita por subnodo
  lng             Float?
  visibilidad     String   @default("public") @map("visibilidad") // ActivoVisibilidadSchema: public | generalized | restricted (ADR-036)
  procedencia     Json?    @map("procedencia") // ActivoProcedenciaSchema (ADR-035)
  consentimiento  Json?    @map("consentimiento") // ActivoConsentimientoSchema — granular, Ley 25.326
  is_synthetic    Boolean  @default(false) @map("is_synthetic")
  created_by_hash String   @map("created_by_hash") // pseudónimo sha256(usuario_id) — sin PII
  hash            String?  @unique @map("hash") // idempotencia de la ingesta curada (seed-activo-*)
  created_at      DateTime @default(now()) @map("created_at")
  updated_at      DateTime @updatedAt @map("updated_at")

  clasificaciones activos_clasificaciones[]
  patrimonio activos_patrimonio?
  productos      productos[]
  operativa      activos_operativa?
  observaciones  patrimonio_observaciones[]
  comercio_ficha  comercio_ficha?
  comercio_relay  comercio_relay[]

  /// Geometría puntal WGS84: columna + trigger + índice GiST en la migración
  /// versionada 20261008200000_r5b_activos (NULL-safe desde VIG-002: sin
  /// punto verificado, geom es null — no se inventa geometría).
  geom Unsupported("geometry(Point,4326)")?

  @@index([estado])
  @@index([nodo_key])
  @@index([subnodo_key])
  @@map("activos")
}

// ─── NODO-CAPITAL NCAP-R6 (#158): Bloque 9 — Banco de Potencialidades ───

/// Oportunidades de desarrollo local (Bloque 9 del documento de la DH):
/// capacidades, recursos, demandas, vacíos y vínculos. Nace 'detected' con
/// evidencia obligatoria; ciclo de vida detected → under_review → validated
/// → prioritized → in_development → active → implemented (+ paused/discarded/
/// archived) — la matriz de transiciones vive en la API. SIN geometría propia:
/// el contexto territorial se acredita por nodo_key + subnodo_key opcional
/// (criterio estructural #149/#158 — no duplicar geometría). Autor = pseudónimo
/// sha256(usuario_id) truncado — sin PII (Ley 25.326, ADR-027). Actores con
/// consentimiento confirmado si se nombran. hash único → idempotencia del alta.
model oportunidades {
  id              String   @id @default(cuid())
  tipo            String   @map("tipo") // OportunidadTipoSchema (10 tipos)
  titulo          String   @map("titulo")
  descripcion     String   @map("descripcion")
  estado          String   @default("detected") @map("estado") // OportunidadEstadoSchema
  nodo_key        String   @map("nodo_key") // capital | caucete | iglesia
  subnodo_key     String?  @map("subnodo_key") // e.g. sj_capital_centro — provisional (NCAP-R2 #154)
  evidencia       Json     @map("evidencia") // OportunidadEvidenciaSchema validado por Zod
  actores         Json     @map("actores") // [OportunidadActorSchema] — consentimiento si se nombran
  tags            Json     @map("tags") // etiquetas libres acotadas
  created_by_hash String   @map("created_by_hash") // pseudónimo — sin PII
  hash            String   @unique @map("hash") // idempotencia del alta
  created_at      DateTime @default(now()) @map("created_at")
  updated_at      DateTime @updatedAt @map("updated_at")
  scoring              Json?    @map("scoring") // NCAP-R6-ext #165: interpretación con método (ADR-035) — null honesto
  territorial_context  Json?    @map("territorial_context") // NCAP-R6-ext #165: cor_* v0.1 (hipótesis provisional #156)

  @@index([nodo_key])
  @@index([estado])
  @@map("oportunidades")
}

// ─── NCAP-R6-ext (#165): vínculos entre actores de una oportunidad ───

/// Conexión oferta/demanda entre dos actores de UNA oportunidad (Bloque 9):
/// consentimiento explícito obligatorio — el contrato Zod exige literal true
/// (ADR-027, Ley 25.326): sin consentimiento confirmado no hay vínculo.
/// hash único → idempotencia del vínculo (mismo autor + actores + tipo).
model oportunidad_conexiones {
  id                        String   @id @default(cuid())
  oportunidad_id            String   @map("oportunidad_id")
  actor_origen              Json     @map("actor_origen") // OportunidadActorSchema
  actor_destino             Json     @map("actor_destino") // OportunidadActorSchema
  tipo_vinculo              String   @map("tipo_vinculo") // oferta | demanda | colaboracion
  consentimiento_confirmado Boolean  @map("consentimiento_confirmado") // siempre true — compuerta del contrato
  created_by_hash           String   @map("created_by_hash") // pseudónimo del autor — sin PII
  hash                      String   @unique @map("hash") // idempotencia del vínculo
  created_at                DateTime @default(now()) @map("created_at")

  @@index([oportunidad_id])
  @@map("oportunidad_conexiones")
}

// ─── NODO-VIG VIG-001 (#171, épica #167): subnodos territoriales ───

/// Subnodos territoriales del nodo iglesia (Opción B ratificada, #167):
/// distritos, parajes, subparajes y localidades INDEC. Jerarquía de 3 niveles
/// por self-relation parent_key → subnodos.key (distrito → paraje →
/// subparaje); los parajes de alta cordillera cuelgan del nodo (parent_key
/// null). lat/lng SOLO con punto público (BAHRA/Georef) — null es honesto,
/// nunca un punto inventado (R15, ADR-036). external_id = cod_ase BAHRA o id
/// Georef. SIN columna geom: no se duplica dominio espacial (criterio
/// estructural #149/#167 — mismo patrón que oportunidades).
model subnodos {
  id               String   @id @default(cuid())
  nodo_key         String   @map("nodo_key") // capital | caucete | iglesia
  key              String   @unique @map("key") // sj_iglesia_<slug> | sj_iglesia_p_<slug>
  label            String   @map("label")
  type             String   @map("type") // SubnodoTipoSchema: district | paraje | subparaje | locality
  parent_key       String?  @map("parent_key")
  boundary_status  String   @default("provisional") @map("boundary_status") // SubnodoBoundaryStatusSchema
  assignment_status String  @map("assignment_status") // SubnodoAssignmentStatusSchema
  zone             String?  @map("zone") // SubnodoZoneSchema — null = sin clasificación aún
  lat              Float?
  lng              Float?
  external_id      String?  @map("external_id") // BAHRA cod_ase | Georef id
  external_source  String?  @map("external_source") // bahra | georef
  created_at       DateTime @default(now()) @map("created_at")
  updated_at       DateTime @updatedAt @map("updated_at")

  parent   subnodos?  @relation("SubnodoJerarquia", fields: [parent_key], references: [key])
  children subnodos[] @relation("SubnodoJerarquia")

  @@index([nodo_key])
  @@index([type])
  @@index([parent_key])
  @@map("subnodos")
}

// ─── NODO-VIG VIG-002 (#169, épica #167): clasificación multimodal ───

/// Clasificaciones de activos (taxonomía 3 niveles del VIG-000): N1 capital
/// (productivo_rural | turistico | patrimonial | civico_social) → N2 categoría
/// → N3 subcategoría ('' = sin subcategoría). Un activo tiene exactamente una
/// clasificación primaria y varias secundarias; toda clasificación declara su
/// fuente (gobernanza VIG-000). Único por (activo, n1, n2, n3) → seed
/// idempotente vía ON CONFLICT.
model activos_clasificaciones {
  id         String   @id @default(cuid())
  activo_id  String   @map("activo_id")
  n1         String   @map("n1") // ActivoCapitalN1Schema
  n2         String   @map("n2")
  n3         String   @default("") @map("n3")
  is_primary Boolean  @default(false) @map("is_primary")
  source     String   @map("source") // fuente de la clasificación
  created_at DateTime @default(now()) @map("created_at")

  activo activos @relation(fields: [activo_id], references: [id], onDelete: Cascade)

  @@unique([activo_id, n1, n2, n3])
  @@index([n1])
  @@map("activos_clasificaciones")
}

// ─── NODO-VIG VIG-003 (NVIG-R3 #182, épica #167): KPIs del nodo ───

/// Snapshots materializados de KPIs por nodo (set honesto v1 ratificado por
/// la DH 2026-10-14): agregados SIN PII (Ley 25.326), visibilidad
/// restricted excluida del cálculo (ADR-036). PK compuesta (nodo_key,
/// kpi_key) → el recompute del consumidor vig003-kpi es un upsert
/// idempotente que re-deriva desde las tablas de dominio, nunca incrementos.
/// valor null = métrica sin computar (cobertura v1) — null honesto (R15).
model kpi_snapshots {
  id          String   @unique @default(cuid())
  nodo_key    String   @map("nodo_key") // capital | caucete | iglesia
  kpi_key     String   @map("kpi_key") // KpiKeySchema (9 KPIs v1)
  valor       Float?   @map("valor") // null honesto (R15): sin métrica computada
  detalles    Json     @map("detalles") // desglose por clave — solo agregados numéricos
  computed_at DateTime @map("computed_at")
  created_at  DateTime @default(now()) @map("created_at")
  updated_at  DateTime @updatedAt @map("updated_at")

  @@id([nodo_key, kpi_key])
  @@map("kpi_snapshots")
}

// ─── NODO-VIG VIG-004 (NVIG-R6 #173, épica #167): patrimonio protegido ───

/// Ficha patrimonial protegida (1:1 con activos — patrón "extender el dominio"
/// ratificado por la DH 2026-10-14, traza #173 comment 6159546907): la
/// declaratoria (proteccion_nivel + proteccion_norma), el estado de
/// conservación, el punto público de acceso y las reglas son registro
/// publicable; `sensible` (geometría/datos internos de custodia) NUNCA sale
/// en las lecturas públicas (ADR-036) — de él solo se publica su estado
/// honesto sensible_status ('sin_relevamiento' = R15: no existe coordenada
/// precisa en nuestras fuentes). SIN columna geom: el punto de acceso es un
/// par de floats con fuente (criterio estructural #149/#167, patrón subnodos).
model activos_patrimonio {
  id                  String   @id @default(cuid())
  activo_id           String   @unique @map("activo_id")
  proteccion_nivel    String   @map("proteccion_nivel") // PatrimonioProteccionNivelSchema
  proteccion_norma    String   @map("proteccion_norma")
  conservacion_estado String?  @map("conservacion_estado")
  acceso_lat          Float?
  acceso_lng          Float?
  reglas_acceso       Json     @map("reglas_acceso") // [{regla, fuente}]
  sensible            Json?    @map("sensible") // custodia — NUNCA en lectura pública
  sensible_status     String   @default("sin_relevamiento") @map("sensible_status") // PatrimonioSensibleStatusSchema
  sensible_nota       String?  @map("sensible_nota") // nota honesta del estado de custodia
  created_at          DateTime @default(now()) @map("created_at")
  updated_at          DateTime @updatedAt @map("updated_at")

  activo activos @relation(fields: [activo_id], references: [id], onDelete: Cascade)

  @@map("activos_patrimonio")
}

// ─── NODO-VIG VIG-005 (NVIG-R7 #174, épica #167): producción y turismo ───

/// Catálogo de productos del territorio (1:N con activos — Opción A ratificada
/// por la DH 2026-10-14, traza #174 comment 6160361362): vinos pateros,
/// tejidos, servicios de temporada. Alta ciudadana autenticada con moderación:
/// nace 'propuesto' (la propuesta es registro comunitario, nunca publicada
/// como verificado); autor = pseudónimo sha256(usuario_id) — sin PII.
/// temporada_meses es un array JSON de meses 1-12: [] = sin_dato honesto
/// (R15). La semilla siembra 0 productos: solo se publica lo verificado.
model productos {
  id              String   @id @default(cuid())
  activo_id       String   @map("activo_id")
  slug            String   @map("slug")
  nombre          String   @map("nombre")
  categoria       String?  @map("categoria")
  temporada_meses Json     @map("temporada_meses") // [1..12] — [] = sin_dato (R15)
  estado          String   @default("propuesto") @map("estado") // ProductoEstadoSchema
  procedencia     Json?    @map("procedencia") // ActivoProcedenciaSchema (ADR-035)
  precio_centavos Int?      // MK-3b (#426): precio en centavos AR ENTEROS — jamás float (D2); null = sin_dato (R15)
  vigencia_desde  DateTime? // MK-3b (#426): ventana de vigencia declarada (RFC-027)
  vigencia_hasta  DateTime? // MK-3b (#426): ventana de vigencia declarada (RFC-027)
  created_by_hash String   @map("created_by_hash") // pseudónimo — sin PII
  created_at      DateTime @default(now()) @map("created_at")
  updated_at      DateTime @updatedAt @map("updated_at")

  activo activos @relation(fields: [activo_id], references: [id], onDelete: Cascade)

  @@unique([activo_id, slug])
  @@index([estado])
  @@map("productos")
}

/// Operativa del activo (1:1): horario, temporada, capacidad y seguridad.
/// Semilla solo-verificada (decisión DH 2026-10-14): dique Cuesta del Viento
/// con horario Ley 826-G + temporada de picos + capacity_status 'unknown'
/// honesto (sin aforos/plazas verificados — R15); cooperativas solo con
/// habilitación unknown en 4 atributos (padrón Ley 2400-T no encontrado).
/// SIN columna geom (criterio estructural #149/#167, patrón patrimonio).
model activos_operativa {
  activo_id        String   @id @map("activo_id")
  horario          String?  @map("horario")
  temporada_meses  Json     @map("temporada_meses") // [1..12] — [] = sin_dato
  capacity_status  String   @default("unknown") @map("capacity_status") // OperativaCapacityStatusSchema
  capacidad_plazas Int?     @map("capacidad_plazas")
  seguridad        Json?    @map("seguridad") // protocolos verificados con fuente
  habilitacion     Json?    @map("habilitacion") // HabilitacionSchema (4 atributos)
  procedencia      Json?    @map("procedencia") // ActivoProcedenciaSchema (ADR-035)
  institucional    Json?    @map("institucional") // OperativaInstitucionalSchema (VIG-008 #240) — solo tras consentimiento formal
  created_at       DateTime @default(now()) @map("created_at")
  updated_at       DateTime @updatedAt @map("updated_at")

  activo activos @relation(fields: [activo_id], references: [id], onDelete: Cascade)

  @@map("activos_operativa")
}

// ─── NODO-VIG VIG-006 (NVIG-R8 #188, épica #167): RAG territorial ético ───

/// Índice RAG del nodo (consulta territorial ética — Bloque 11 del VIG-000):
/// fragmentos de prosa autorizada SOLO de contenido publicado (subnodos,
/// activos aprobados no restricted con sus fichas patrimonial/operativa
/// públicas, KPIs agregados). NUNCA ingiere: visibilidad restricted
/// (ADR-036), el campo sensible de custodia (VIG-004), consentimiento ni PII
/// (Ley 25.326). Recompute idempotente por el consumidor vig006-rag-index del
/// worker (patrón vig003-kpi): upsert por (nodo_key, source_type, source_id)
/// que re-deriva desde las tablas de dominio; delete lógico del fragmento si
/// el registro deja de calificar (p. ej. pasó a restricted). La columna
/// generada search (to_tsvector('spanish', texto) + índice GIN) vive en la
/// migración versionada — Prisma no tipa tsvector.
model rag_index {
  id          String   @unique @default(cuid())
  nodo_key    String   @map("nodo_key") // capital | caucete | iglesia
  source_type String   @map("source_type") // RagSourceTypeSchema: subnodo | activo | kpi
  source_id   String   @map("source_id") // subnodo.key | activo.id | kpi_key
  subnodo_key String?  @map("subnodo_key") // contexto distrital del fragmento
  texto       String   @map("texto") // prosa autorizada — nunca sensible ni PII
  fuentes     Json     @map("fuentes") // [{fuente, fecha?}] — ADR-035
  computed_at DateTime @map("computed_at")
  created_at  DateTime @default(now()) @map("created_at")
  updated_at  DateTime @updatedAt @map("updated_at")

  @@id([nodo_key, source_type, source_id])
  @@map("rag_index")
}

// ─── NODO-CAU R4 (#149): ficha de valoración comunitaria del espacio público ───

/// Ficha de valoración comunitaria del espacio público — testimonio revisable
/// (ADR-036). La ficha NO tiene geometría propia: se ancla a un feature de la
/// capa public_space (el espacio ES el feature; la ubicación la acredita el
/// espacio — sin duplicar lat/lng ni geom). Estados: testimonio → corroborada
/// | descartada; la corroboración puede ser individual (moderación) o de taller
/// comunitario (validación colectiva). Autor = pseudónimo sha256(usuario_id)
/// truncado — sin PII (Ley 25.326, ADR-027). hash único → idempotencia del
/// alta (mismo ciudadano + espacio + versión + respuestas = una sola ficha).
model fichas_valoracion {
  id              String   @id @default(cuid())
  nodo_key        String   @map("nodo_key")
  feature_id      String   @map("feature_id") // espacio (capa public_space)
  version         String   @map("version") // versión del instrumento (v1)
  respuestas      Json     @map("respuestas") // FichaRespuestasV1 validado por Zod
  estado          String   @default("testimonio") @map("estado") // testimonio | corroborada | descartada
  corroboracion   String?  @map("corroboracion") // individual | taller_comunitario
  created_by_hash String   @map("created_by_hash") // pseudónimo — sin PII
  hash            String   @unique @map("hash") // idempotencia del alta
  created_at      DateTime @default(now()) @map("created_at")
  updated_at      DateTime @updatedAt @map("updated_at")

  @@index([nodo_key])
  @@index([feature_id])
  @@map("fichas_valoracion")
}

// ─── NODO-CAU R2 (#138/#147): catálogo de fuentes espaciales + procedencia ───

/// Catálogo de fuentes espaciales (#147): registro público de las fuentes de
/// datos del sistema — organismo, URL, tipo de acceso, licencia, estado honesto
/// de disponibilidad y CAUTELA central. No es un catálogo de datos: es el
/// registro de procedencia que toda ingesta real debe citar (ADR-035, R15).
/// Multinodo: una fuente puede servir a varios nodos (IGN, INDEC, BAHRA).
model fuentes {
  id         String   @id @default(cuid())
  key        String   @unique @map("key") // p.ej. ign, refes, catastro_sj
  organismo  String   @map("organismo")
  nombre     String   @map("nombre")
  url        String?  @map("url") // URL estable de la fuente — null si no existe
  tipo       String   @map("tipo") // FuenteEspacialTipoSchema: wms|wfs|descarga|documento|api
  licencia   String?  @map("licencia") // null = sin licencia declarada aún
  estado     String   @map("estado") // FuenteEspacialEstadoSchema (verificación 2026-10-11)
  cautela    String   @map("cautela") // cautela central honesta (#147)
  created_at DateTime @default(now()) @map("created_at")
  updated_at DateTime @updatedAt @map("updated_at")

  @@index([organismo])
  @@index([tipo])
  @@map("fuentes")
}

/// Procedencia por conjunto (#147, contrato de procedencia): cada ingesta de
/// datos externos declara fuente del catálogo, capa/servicio, fechas de acceso
/// y corte, licencia, CRS origen/normalizado, escala/precisión, id externo y
/// transformaciones. Pipeline recibido → validado_tecnicamente →
/// validado_territorialmente → publicado; `publicado` solo admin (decisión DH
/// 2026-10-15 — ingesta curada de datos reales, R15). SIN geometría: la ingesta
/// acredita procedencia; los datos viven en sus tablas de dominio (criterio
/// estructural #149). Autor = pseudónimo sha256(usuario_id) — sin PII.
model ingestas {
  id               String   @id @default(cuid())
  source_id        String   @map("source_id") // id del conjunto en la fuente
  fuente_key       String   @map("fuente_key") // → fuentes.key (validado en la ruta)
  nodo_key         String   @map("nodo_key")
  capa_servicio    String   @map("capa_servicio") // capa WMS/WFS o dataset descargado
  fecha_acceso     String   @map("fecha_acceso") // YYYY-MM-DD
  fecha_corte      String   @map("fecha_corte") // YYYY-MM-DD o YYYY (año suelto)
  licencia         String?  @map("licencia")
  crs_origen       String   @map("crs_origen")
  crs_normalizado  String   @map("crs_normalizado")
  escala_precision String   @map("escala_precision")
  external_id      String?  @map("external_id") // id externo original del conjunto
  transformaciones String?  @map("transformaciones")
  estado           String   @default("recibido") @map("estado") // IngestaEstadoSchema
  created_by_hash  String   @map("created_by_hash") // pseudónimo — sin PII
  hash            String   @unique @map("hash") // idempotencia del alta
  created_at       DateTime @default(now()) @map("created_at")
  updated_at       DateTime @updatedAt @map("updated_at")

  @@unique([fuente_key, source_id])
  @@index([nodo_key])
  @@index([estado])
  @@map("ingestas")
}

// ─── MARKET-CAP MK-1 (#243, sub-épica #152): Mercado de Proximidad ───

/// Ficha de mercado 1:1 con activos (patrón activos_patrimonio/activos_operativa,
/// Opción A ratificada por la DH 2026-10-17): SOLO el dominio específico del
/// mercado. Estado, visibilidad, consentimiento, procedencia, pseudónimo y
/// geometría viven en `activos` (no se duplican — lección #161). SIN PII de
/// contacto en v1 (decisión DH: relay por plataforma, Ley 25.326 minimización).
/// Frontera de dominio: la habilitación COMERCIAL vive aquí; la habilitación
/// del prestador turístico (Ley 2400-T) vive en activos_operativa.habilitacion.
/// Multinodo desde día 1: el scope de nodo vive en activos.nodo_key (#243).
model comercio_ficha {
  activo_id    String   @id @map("activo_id")
  rubro_id     String   @map("rubro_id") // join por código → directoryTaxonomy.idCategoria (ADR-035)
  rubro_rama   String?  @map("rubro_rama") // RamaTaxonomica — desnormalización de facetas
  atributos    Json     @map("atributos") // ComercioAtributosSchema (delivery, pagos, accesibilidad, venta_directa)
  habilitacion Json     @map("habilitacion") // ComercioHabilitacionSchema (estados epistémicos)
  titularidad  Json     @map("titularidad") // ComercioTitularidadSchema (reclamo/verificación — sin PII)
  created_at   DateTime @default(now()) @map("created_at")
  updated_at   DateTime @updatedAt @map("updated_at")

  activo activos @relation(fields: [activo_id], references: [id], onDelete: Cascade)

  @@index([rubro_id])
  @@map("comercio_ficha")
}


/// Observaciones de estado patrimonial (VIG-009 R1): testimonios append-only de
/// ciudadanos sobre activos con ficha patrimonial (VIG-004). Cada observación es
/// un testimonio con checklist estructurado y evidencia — JAMÁS un diagnóstico:
/// el estado de conservación global nunca se publica como verificado sin informe
/// técnico oficial (R15, diseño #241). SIN updated_at: la tabla es append-only, no
/// se edita ni se borra (trazabilidad inmutable, ADR-038). Autor = pseudónimo
/// sha256(usuario_id) truncado — sin PII (Ley 25.326, ADR-027). hash único →
/// idempotencia del alta (mismo ciudadano + activo + fecha + checklist + nota =
/// una sola observación).
model patrimonio_observaciones {
  id                String   @id @default(cuid())
  activo_id         String   @map("activo_id")
  fecha_observacion String   @map("fecha_observacion") // YYYY-MM-DD — fecha del testimonio
  checklist         Json     @map("checklist") // PatrimonioObservacionChecklistSchema (VIG-009 R1)
  nota              String?  @map("nota")
  evidencia         Json     @map("evidencia") // PatrimonioObservacionEvidenciaSchema — testimonio con fuente
  created_by_hash   String   @map("created_by_hash") // pseudónimo sha256(usuario_id) — sin PII
  hash              String   @unique @map("hash") // idempotencia del alta
  created_at        DateTime @default(now()) @map("created_at")

  activo activos @relation(fields: [activo_id], references: [id], onDelete: Cascade)

  @@index([activo_id])
  @@map("patrimonio_observaciones")
}

// ─── NODO-CAPITAL NCAP-R4 (#156): red de corredores v0.1 ───

/// Corredores como red modelada (#156): grafo relacional — corredor →
/// segmentos → hitos/subnodos vinculados. SIN columna geom en v0.1 (R15:
/// sin fuente verificada no hay traza dibujada — nada se presenta como
/// traza oficial). status = vocabulario territorialModel (#233):
/// candidate (hipótesis DH) | mapped | validated | retired.
model corredores {
  id          String   @id @default(cuid())
  key         String   @unique @map("key") // cor_* v0.1 (#156) — vocabulario ratificado
  nodo_key    String   @map("nodo_key")
  label       String   @map("label")
  proposito   String   @map("proposito") // ≥10 — el corredor exige propósito declarado
  status      String   @default("candidate") @map("status") // CorredorStatusSchema
  created_at  DateTime @default(now()) @map("created_at")
  updated_at  DateTime @updatedAt @map("updated_at")

  segmentos corredor_segmentos[]

  @@index([nodo_key])
  @@map("corredores")
}

/// Hitos nodales de la red (#156): puntos de articulación (plazas, parques,
/// edificios públicos, áreas analíticas). REGLA #154: SIN asignación
/// distrital — participan por relaciones connects/near. lat/lng NULL
/// honestos: sin punto verificado no se publica (R15, ADR-035). Catálogo
/// GLOBAL del nodo: un hito compartido (p. ej. Parque de Mayo) pertenece a
/// la red, no a un corredor — la pertenencia la derivan los segmentos.
model corredor_hitos {
  id         String   @id @default(cuid())
  key        String   @unique @map("key") // hit_* — slug del vocabulario v0.1
  nodo_key   String   @map("nodo_key")
  label      String   @map("label")
  tipo       String   @map("tipo") // CorredorHitoTipoSchema
  lat        Float?   @map("lat") // NULL honesto — punto a verificar (R15)
  lng        Float?   @map("lng")
  notas      String?  @map("notas")
  created_at DateTime @default(now()) @map("created_at")

  @@index([nodo_key])
  @@map("corredor_hitos")
}

/// Segmentos del corredor (#156): tramos from/to tipados (hito|subnodo con
/// key) + secuencia para continuidad + modos (walk|bike|bus|car|unknown,
/// territorialModel #233) + observaciones de superficie/cruces + observed_at
/// + fuentes por tramo (ADR-035: una relación sin fuente es una invención).
/// @@unique([corredor_id, secuencia]) → idempotencia del seed y continuidad
/// revisable (la API deriva ok|ruptura de esta cadena).
model corredor_segmentos {
  id            String   @id @default(cuid())
  corredor_id   String   @map("corredor_id")
  secuencia     Int      @map("secuencia") // 1..N — orden del tramo
  from_tipo     String   @map("from_tipo") // hito | subnodo
  from_key      String   @map("from_key") // hit_* o sj_*
  to_tipo       String   @map("to_tipo")
  to_key        String   @map("to_key")
  modos         Json     @map("modos") // [CorredorModoSchema] — walk|bike|bus|car|unknown
  observaciones Json?    @map("observaciones") // superficie/cruces — testimonio, no catastro (R15)
  observed_at   DateTime @map("observed_at") // fecha del relevamiento del tramo
  fuentes       Json     @map("fuentes") // [CorredorFuenteSchema] — evidencia por tramo (ADR-035)
  created_at    DateTime @default(now()) @map("created_at")

  corredor corredores @relation(fields: [corredor_id], references: [id], onDelete: Cascade)

  @@unique([corredor_id, secuencia])
  @@index([corredor_id])
  @@map("corredor_segmentos")
}

// ─── NODO-VIG-3 VIG-011 (#378, épica #377): AMC — registro de mediadores ───

/// Registro comunitario de mediadores del AMC (boca única de reporte del
/// nodo): alias público + aval (asamblea | comision_vecinal — comunitario,
/// no gubernamental, R15). SIN PII: no nombre ni contacto — la devolución
/// al vecino va por el canal de origen (web: su cuenta; papel/whatsapp:
/// el mediador con aval). Nace VACÍA (R15): la asamblea aún no ratificó
/// mediadores — ninguna fila se siembra (conteo 0 honesto).
model mediadores {
  id          String   @id @default(cuid())
  nodo_key    String   @map("nodo_key")
  key         String   @unique @map("key") // alias comunitario único del mediador (slug)
  label       String   @map("label") // rol visible (p.ej. «mediador de asamblea — Tudcum»)
  aval        String   @map("aval") // MediadorAvalSchema: asamblea | comision_vecinal
  aval_estado String   @default("vigente") @map("aval_estado") // vigente | retirado — retiro por decisión comunitaria
  created_at  DateTime @default(now()) @map("created_at")
  updated_at  DateTime @updatedAt @map("updated_at")

  @@index([nodo_key])
  @@map("mediadores")
}

// ─── NODO-VIG-3 VIG-012 (#379, épica #377): pedidos formales ───

/// Pedidos formales del nodo (libro de reclamos del plan vecinal ante
/// DPV): ÚNICA tabla nueva del módulo (decisión DH 2026-11-06). Nace
/// VACÍA (R15): preparar la nota ≠ presentarla — los 15 pedidos de la
/// nota formal a DPV son contenido documental (fuente: documento vecinal
/// interno, sin firmantes expuestos ADR-027), NO filas precargadas; cada
/// pedido se crea a medida que se presenta, con fecha real y sello
/// 'pedido.presentado'. Ciclo: presentado → respondido_en_plazo |
/// respondido_tardio ('sin_respuesta' NO se transita: se DERIVA en
/// lectura — plazo vencido sin respuesta, R15). La evidencia cita los
/// puntos críticos corroborados del AMC (features pc-* community_validated
/// de VIG-011: N reportes de M reportantes detrás). Autor = pseudónimo
/// sha256(usuario_id) truncado — sin PII (Ley 25.326, ADR-027).
model pedidos {
  id                     String    @id @default(cuid())
  nodo_key               String    @map("nodo_key")
  key                    String    @unique @map("key") // slug único del pedido (p. ej. dpv_01_proyecto)
  bloque                 String    @map("bloque") // PedidoBloqueSchema: bloques A-E de la nota a DPV
  tema                   String    @map("tema") // tema público del pedido (anti-PII al crear)
  destinatario           String    @map("destinatario") // organismo destinatario (p. ej. DPV)
  fecha_presentacion     DateTime  @map("fecha_presentacion") // fecha REAL de presentación (no futura — R15)
  plazo_dias             Int       @map("plazo_dias") // plazo declarado de respuesta
  estado                 String    @default("presentado") @map("estado") // presentado | respondido_en_plazo | respondido_tardio
  respondido_en          DateTime? @map("respondido_en") // fecha de la respuesta del organismo
  nota_respuesta         String?   @map("nota_respuesta") // nota pública de la respuesta (anti-PII)
  evidencia_cluster_keys String[]  @map("evidencia_cluster_keys") // → features pc-* (punto_critico community_validated, VIG-011)
  created_by_hash        String    @map("created_by_hash") // pseudónimo sha256(usuario_id) — ADR-027
  hash                   String    @unique @map("hash") // idempotencia del registro
  created_at             DateTime  @default(now()) @map("created_at")
  updated_at             DateTime  @updatedAt @map("updated_at")

  @@index([nodo_key, estado])
  @@map("pedidos")
}

// ─── MARKET-CAP MK-4a (#427, épica #422): relay del Mercado de Proximidad ───

/// Mensajes del relay (MK-4a): canal ÚNICO de contacto — jamás PII de
/// contacto (Ley 25.326): el mensaje pasa la compuerta anti-PII (ADR-020
/// cond. 1) en la ruta ANTES de persistir; el remitente vive SOLO como
/// pseudónimo sha256(usuario_id) truncado (ADR-027). Idempotencia por hash
/// (usuario + comercio + mensaje) — el reintento no duplica. La bandeja es
/// lectura del titular (reclamada O verificada — decisión DH 2026-11-07).
model comercio_relay {
  id              String   @id @default(cuid())
  comercio_id     String   @map("comercio_id")
  mensaje         String   @map("mensaje") // texto anti-PII (compuerta en la ruta)
  creado_por_hash String   @map("creado_por_hash") // pseudónimo — sin PII
  hash            String   @unique @map("hash") // idempotencia del relay
  created_at      DateTime @default(now()) @map("created_at")

  activo activos @relation(fields: [comercio_id], references: [id], onDelete: Cascade)

  @@index([comercio_id, created_at])
  @@map("comercio_relay")
}
